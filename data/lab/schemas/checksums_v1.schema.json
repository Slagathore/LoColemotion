{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/checksums_v1.schema.json",
  "title": "SporeSpore immutable artifact checksums v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "algorithm",
    "artifact_count",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.checksums.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "algorithm": {
      "const": "sha256"
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "kind", "records"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": ["json", "jsonl", "opaque"]
        },
        "records": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    }
  }
}
