{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br13_canonical_get_up_promotion_campaign_v1.schema.json",
  "title": "SporeSpore BR13 constrained canonical get-up promotion campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "milestone_id",
    "claim_boundary",
    "process_policy",
    "source_policy",
    "br1_inventory_guard",
    "role_accounting",
    "programs",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br13_canonical_get_up_promotion_campaign.v1"
    },
    "campaign_id": {
      "const": "BR13_CANONICAL_GET_UP_PROMOTION_CAMPAIGN_V1"
    },
    "campaign_version": {
      "const": 1
    },
    "milestone_id": {
      "const": "BR13_CONSTRAINED_CANONICAL_GET_UP"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the exact source-pinned BR13.0 canonical symmetry-collapsed quadruped profile, semantic prone/transition/stance observation, and successful phase-order scope; BR13.2 static work/reserve preflight and explicit post-trace actuator, contact-dissipation, guide-work, and energy-residual accounting scope; and BR13.4 digest-bound three-seed paired active-recovery and zero-command-control live Godot/Jolt scope. BR13.1 timeout, revocation, forbidden-contact, and exclusive-handoff checks and BR13.3 adversarial profile, scaffold, contact, claim, anatomy, seed, and guidance containment are integrity-only and cannot substitute for a milestone program. The BR13.4 analyzer boundary is verbatim: BR13 paired live Godot/Jolt recovery for one exact symmetry-collapsed quadruped laboratory profile. Each active seed begins in observed semantic ventral-contact prone, establishes ordinary front-pair and rear-pair distal support, raises measured whole-system center of mass with finite paired actuation, hands exclusively from the recovery controller to the stance controller, and completes the declared stance dwell. Each seed is compared with one same-state zero-command control that remains prone. Command receipts, transition-integrated actuator work, residual-inferred contact dissipation, and the material out-of-plane guide impulse/work boundary remain explicit. The positive conclusion is exactly constrained_planar_get_up for this fixture. It establishes no free-3D recovery, morphology transfer, gait, walking, repair, or automatic creature guidance. The material sagittal guide remains part of the experiment, each front or rear rigid strut represents a mirrored limb pair rather than independent left/right limbs, raw contact observations establish no per-foot load allocation, and no result generalizes beyond the exact source-pinned profile, actuator, thresholds, seed set, physics rate, or floor fixture."
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_committed_source",
        "fresh_godot_process_per_replicate",
        "required_replicates_per_program",
        "pid_recycle_policy",
        "test_timeout_seconds",
        "complete_campaign_required",
        "cherry_pick_policy"
      ],
      "properties": {
        "clean_committed_source": {
          "const": true
        },
        "fresh_godot_process_per_replicate": {
          "const": true
        },
        "required_replicates_per_program": {
          "const": 2
        },
        "pid_recycle_policy": {
          "const": "allowed_only_for_nonoverlapping_completed_invocations_and_recorded"
        },
        "test_timeout_seconds": {
          "const": 300
        },
        "complete_campaign_required": {
          "const": true
        },
        "cherry_pick_policy": {
          "const": "forbidden_all_declared_runs_retained"
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "inventory_roots"
      ],
      "properties": {
        "identity": {
          "const": "clean_git_commit_plus_exact_declared_byte_inventory_v1"
        },
        "inventory_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inventory_root"
          }
        }
      }
    },
    "br1_inventory_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_path",
        "sha256",
        "test_count",
        "mutation_forbidden"
      ],
      "properties": {
        "resource_path": {
          "const": "res://data/lab/campaigns/BR1_required_lab_tests_v2.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "test_count": {
          "const": 62
        },
        "mutation_forbidden": {
          "const": true
        }
      }
    },
    "role_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone",
        "supplementary",
        "integrity",
        "total"
      ],
      "properties": {
        "milestone": {
          "$ref": "#/$defs/milestone_role_count"
        },
        "supplementary": {
          "$ref": "#/$defs/zero_role_count"
        },
        "integrity": {
          "$ref": "#/$defs/integrity_role_count"
        },
        "total": {
          "$ref": "#/$defs/total_role_count"
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Free-3D, unscaffolded, or morphology-generalized self-righting or recovery",
          "An absent, negligible, or generally measured out-of-plane scaffold reaction",
          "Independent left-right control of four articulated limbs",
          "Morphology, actuator, terrain, complex-foot, endurance, or physics-setting transfer",
          "Per-contact, per-body, per-foot, per-toe, or center-of-pressure load allocation",
          "General standing, balance, bracing, fall arrest, or recovery outside the exact terminal dwell",
          "A step, weight-transfer maneuver, gait, candidate walking, or walking",
          "Creature repair, accepted encyclopedia knowledge, or automatic creature guidance"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "extensions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "tree"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^\\.[a-z0-9]+$"
          }
        }
      }
    },
    "role_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programs",
        "assertions_per_replicate"
      ],
      "properties": {
        "programs": {
          "type": "integer",
          "minimum": 0
        },
        "assertions_per_replicate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "milestone_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 3
            },
            "assertions_per_replicate": {
              "const": 57
            }
          }
        }
      ]
    },
    "zero_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 0
            },
            "assertions_per_replicate": {
              "const": 0
            }
          }
        }
      ]
    },
    "integrity_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 2
            },
            "assertions_per_replicate": {
              "const": 33
            }
          }
        }
      ]
    },
    "total_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 5
            },
            "assertions_per_replicate": {
              "const": 90
            }
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test_resource_path",
        "expected_assertions",
        "claim_scope"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR13_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "enum": [
            "BR13.0",
            "BR13.1",
            "BR13.2",
            "BR13.3",
            "BR13.4"
          ]
        },
        "evidence_role": {
          "enum": [
            "milestone",
            "supplementary",
            "integrity"
          ]
        },
        "test_resource_path": {
          "type": "string",
          "pattern": "^res://tests/test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
