      "format": "date-time"
    },
    "evidence_basis": {
      "$ref": "#/$defs/evidence_basis"
    },
    "accepted_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$"
      }
    },
    "accepted_capabilities": {
      "$ref": "#/$defs/nonempty_unique_strings"
    },
    "supplementary_constraints": {
      "$ref": "#/$defs/nonempty_unique_strings"
    },
    "claim_boundary": {
