    "decision_id",
    "milestone_id",
    "decision_revision",
    "status",
    "decided_by",
    "authorization",
    "decided_utc",
    "evidence_basis",
    "accepted_contracts",
    "accepted_capabilities",
    "supplementary_constraints",
    "claim_boundary",
    "excluded_capabilities",
    "downstream_open",
    "knowledge_effects",
    "supersedes"
