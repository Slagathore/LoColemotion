{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br3a_knowledge_admission_manifest_v1.schema.json",
  "title": "SporeSpore BR3A knowledge admission manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "status",
    "authorized_by",
    "authorization_basis",
    "decision",
    "guidance_policy",
    "entries"
  ],
  "properties": {
    "schema": {"const": "sporespore.lab.br3a_knowledge_admission_manifest.v1"},
    "manifest_id": {"const": "BR3A_L1_KNOWLEDGE_ADMISSION_V1"},
    "status": {"const": "authorized"},
    "authorized_by": {"const": "Cole"},
    "authorization_basis": {
      "const": "standing_authority_to_accept_recommended_evidence_backed_knowledge"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_sha256"],
      "properties": {
        "decision_id": {"const": "BR3A_L1_ENGINE_CONTACT_TRUTH_DECISION_V1"},
        "decision_sha256": {
          "const": "sha256:78b4a6daae8f7b1f981bf5feed5f54a6dcee08b991b39afe51df85327080bb6d"
        }
      }
    },
    "guidance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "automatic_creature_guidance_allowed",
        "automatic_application_allowed",
        "unlock_requires"
      ],
      "properties": {
        "mode": {"const": "observation_only"},
        "automatic_creature_guidance_allowed": {"const": false},
        "automatic_application_allowed": {"const": false},
        "unlock_requires": {
          "const": [
            "ACCEPTED_SUPPORT_MILESTONE",
            "SEPARATE_GUIDANCE_DECISION"
          ]
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/entry_spec"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {"type": "string", "minLength": 1},
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
    },
    "parameter_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "change", "affects", "mechanism", "hinges_on"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "change": {"type": "string", "minLength": 1},
        "affects": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "hinges_on": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "inline_authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "claim",
        "scope",
        "mechanism",
        "applicability",
        "failure_boundaries",
        "morphology_tags",
        "parameter_effects",
        "unknowns",
        "supersedes"
      ],
      "properties": {
        "kind": {"const": "inline"},
        "title": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "applicability": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "failure_boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "morphology_tags": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_id"},
          "uniqueItems": true
        },
        "parameter_effects": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter_effect"}
        },
        "unknowns": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "supersedes": {
          "type": "array",
          "items": {"$ref": "#/$defs/stable_id"},
          "uniqueItems": true
        }
      }
    },
    "draft_authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"const": "pinned_development_draft"},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entry_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "cell_id",
        "knowledge_class",
        "output_name",
        "program_ids",
        "authoring"
      ],
      "properties": {
        "entry_id": {"$ref": "#/$defs/stable_id"},
        "cell_id": {"pattern": "^L1\\.[0-8]$"},
        "knowledge_class": {
          "enum": ["milestone_observation", "supplementary_constraint"]
        },
        "output_name": {
          "pattern": "^br3a_l1_[0-8]_[a-z0-9_]+\\.v1\\.json$"
        },
        "program_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"pattern": "^BR3A_[A-Z0-9_]+_V1$"},
          "uniqueItems": true
        },
        "authoring": {
          "oneOf": [
            {"$ref": "#/$defs/inline_authoring"},
            {"$ref": "#/$defs/draft_authoring"}
          ]
        }
      }
    }
  }
}
