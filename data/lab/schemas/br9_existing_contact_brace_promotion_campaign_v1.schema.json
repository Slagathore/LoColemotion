{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br9_existing_contact_brace_promotion_campaign_v1.schema.json",
  "title": "SporeSpore BR9 existing-contact planar brace promotion campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "milestone_id",
    "claim_boundary",
    "process_policy",
    "source_policy",
    "br1_inventory_guard",
    "role_accounting",
    "programs",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br9_existing_contact_brace_promotion_campaign.v1"
    },
    "campaign_id": {
      "const": "BR9_EXISTING_CONTACT_BRACE_PROMOTION_CAMPAIGN_V1"
    },
    "campaign_version": {
      "const": 1
    },
    "milestone_id": {
      "const": "BR9_EXISTING_CONTACT_PLANAR_BRACE"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the exact BR9.0 digest-bound existing-contact brace-controller arithmetic, mirrored arrest, bounded load-rate redistribution, explicit residual, and stable-dwell handoff scope; BR9.1 reserve, friction, existing-contact-set, detector-state, finiteness, strict-field, monotonic-tick, and delayed-reaction refusal scope; BR9.2 controller-to-force-map-to-finite-paired-actuator-to-command-ledger-to-executor-to-append-only-receipt scope; and BR9.3 paired no-brace-control and active-brace Godot/Jolt program scope named by the source-pinned programs. BR9.4 is integrity-only containment and cannot substitute for a milestone program. The live pair retains the exact BR7 material scaffold: an explicit unpowered Generic6DOF guide releases sagittal X/Y translation and pitch while locking out-of-plane translation, roll, and yaw; all guide motors and springs remain off; four hinges remain passive; and two ordinary distal contacts are already bearing before the one declared positive pitch impulse. The active controller begins only on the first post-impulse observation, redistributes commanded contact loads inside the declared unilateral, friction, reserve, load-rate, and finite-actuator boundaries, and is compared with a no-brace control receiving the same impulse. Whole-system angular-momentum reconstruction supplies the aggregate external pitch-moment check. Commanded left/right shares are not measured per-foot loads. This establishes scaffold-constrained planar existing-contact pitch arrest only, not a new-contact catch step, per-foot measured load allocation, free-3D bracing or standing, articulated-limb generality, fall arrest, getting up, gait, walking, creature repair, accepted knowledge, or automatic creature guidance."
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_committed_source",
        "fresh_godot_process_per_replicate",
        "required_replicates_per_program",
        "pid_recycle_policy",
        "test_timeout_seconds",
        "complete_campaign_required",
        "cherry_pick_policy"
      ],
      "properties": {
        "clean_committed_source": {
          "const": true
        },
        "fresh_godot_process_per_replicate": {
          "const": true
        },
        "required_replicates_per_program": {
          "const": 2
        },
        "pid_recycle_policy": {
          "const": "allowed_only_for_nonoverlapping_completed_invocations_and_recorded"
        },
        "test_timeout_seconds": {
          "const": 300
        },
        "complete_campaign_required": {
          "const": true
        },
        "cherry_pick_policy": {
          "const": "forbidden_all_declared_runs_retained"
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "inventory_roots"
      ],
      "properties": {
        "identity": {
          "const": "clean_git_commit_plus_exact_declared_byte_inventory_v1"
        },
        "inventory_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inventory_root"
          }
        }
      }
    },
    "br1_inventory_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_path",
        "sha256",
        "test_count",
        "mutation_forbidden"
      ],
      "properties": {
        "resource_path": {
          "const": "res://data/lab/campaigns/BR1_required_lab_tests_v2.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "test_count": {
          "const": 62
        },
        "mutation_forbidden": {
          "const": true
        }
      }
    },
    "role_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone",
        "supplementary",
        "integrity",
        "total"
      ],
      "properties": {
        "milestone": {
          "$ref": "#/$defs/milestone_role_count"
        },
        "supplementary": {
          "$ref": "#/$defs/zero_role_count"
        },
        "integrity": {
          "$ref": "#/$defs/integrity_role_count"
        },
        "total": {
          "$ref": "#/$defs/total_role_count"
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "A new-contact catch step",
          "Per-contact, per-foot, or per-toe measured load allocation",
          "Free 3D bracing, standing, or unconstrained balance",
          "An absent, negligible, or measured out-of-plane scaffold reaction",
          "Articulated-limb, morphology, terrain, complex-foot, or endurance generalization",
          "Fall arrest",
          "Self-righting or getting up",
          "Gait, candidate walking, or walking",
          "Creature repair, accepted encyclopedia knowledge, or automatic creature guidance"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "extensions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "tree"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^\\.[a-z0-9]+$"
          }
        }
      }
    },
    "role_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programs",
        "assertions_per_replicate"
      ],
      "properties": {
        "programs": {
          "type": "integer",
          "minimum": 0
        },
        "assertions_per_replicate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "milestone_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 4
            },
            "assertions_per_replicate": {
              "const": 39
            }
          }
        }
      ]
    },
    "zero_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 0
            },
            "assertions_per_replicate": {
              "const": 0
            }
          }
        }
      ]
    },
    "integrity_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 1
            },
            "assertions_per_replicate": {
              "const": 21
            }
          }
        }
      ]
    },
    "total_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 5
            },
            "assertions_per_replicate": {
              "const": 60
            }
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test_resource_path",
        "expected_assertions",
        "claim_scope"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR9_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "enum": [
            "BR9.0",
            "BR9.1",
            "BR9.2",
            "BR9.3",
            "BR9.4"
          ]
        },
        "evidence_role": {
          "enum": [
            "milestone",
            "supplementary",
            "integrity"
          ]
        },
        "test_resource_path": {
          "type": "string",
          "pattern": "^res://tests/test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}