{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br12_certification_report_v1.schema.json",
  "title": "SporeSpore BR12 certification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "certification",
    "certification_id",
    "milestone_id",
    "claim_boundary",
    "generated_utc",
    "source",
    "engine",
    "bundle_policy",
    "report_attestation_policy",
    "accounting",
    "cells",
    "programs",
    "final_readback",
    "pose_recovery_constraints",
    "capabilities",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br12_certification_report.v1"
    },
    "status": {
      "const": "pass"
    },
    "certification": {
      "const": "BR12_POSE_AND_RECOVERY_FEASIBILITY"
    },
    "certification_id": {
      "type": "string",
      "pattern": "^br12_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{8}$"
    },
    "milestone_id": {
      "const": "BR12_POSE_AND_RECOVERY_FEASIBILITY"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the exact source-pinned BR12.0 semantic body-region contact-role registry and labeled-box basis-oracle scope; BR12.1 deterministic profile-specific canonical-pose classifier scope; BR12.2 semantic anatomy-role recovery-profile matching scope; and BR12.3 conservative static torque, power, structural, friction, and reach feasibility scope. BR12.4 is integrity-only containment and cannot substitute for a milestone program. The BR12 claim boundary is verbatim: BR12 is observer/planner truth only. It classifies only declared labeled-box canonical poses, preserves ambiguous or invalid evidence as unknown, names missing anatomy, and reports whether one exact profile passes preregistered static inequalities before actuation. A feasible report is not dynamic execution evidence. No BR12 program contains a recovery controller, emits an actuator command, wrench, or joint target, creates or maintains contact, applies external assistance, raises a body, hands off to stance, repairs a creature, or guides one automatically. It establishes no physical self-righting or getting up, free-3D standing or bracing, generalized recovery, gait, or walking."
    },
    "generated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "bundle_policy": {
      "$ref": "#/$defs/bundle_policy"
    },
    "report_attestation_policy": {
      "$ref": "#/$defs/report_attestation_policy"
    },
    "accounting": {
      "$ref": "#/$defs/accounting"
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "programs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "final_readback": {
      "$ref": "#/$defs/final_readback"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_knowledge_entries",
        "automatic_creature_guidance_allowed",
        "profile_specific_pose_classification",
        "static_recovery_feasibility_screening",
        "dynamic_recovery_execution",
        "stance_handoff",
        "controller_or_actuator_authority",
        "contact_creation_or_external_assistance",
        "free_3d_bracing",
        "free_3d_standing",
        "unconstrained_balance",
        "generalized_recovery",
        "getting_up",
        "gait",
        "walking"
      ],
      "properties": {
        "accepted_knowledge_entries": {
          "const": 0
        },
        "automatic_creature_guidance_allowed": {
          "const": false
        },
        "profile_specific_pose_classification": {
          "const": true
        },
        "static_recovery_feasibility_screening": {
          "const": true
        },
        "dynamic_recovery_execution": {
          "const": false
        },
        "stance_handoff": {
          "const": false
        },
        "controller_or_actuator_authority": {
          "const": false
        },
        "contact_creation_or_external_assistance": {
          "const": false
        },
        "free_3d_bracing": {
          "const": false
        },
        "free_3d_standing": {
          "const": false
        },
        "unconstrained_balance": {
          "const": false
        },
        "generalized_recovery": {
          "const": false
        },
        "getting_up": {
          "const": false
        },
        "gait": {
          "const": false
        },
        "walking": {
          "const": false
        }
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Physical self-righting or getting up",
          "Dynamic recovery execution or stance handoff",
          "Controller, actuator, wrench, or joint-target authority",
          "Contact creation, maintenance, or external assistance",
          "Generalization beyond the exact labeled-box bases, pose profiles, anatomy roles, and thresholds",
          "Free 3D standing, bracing, recovery, or unconstrained balance",
          "Per-contact, per-body, per-foot, or per-toe measured load allocation",
          "Gait, candidate walking, or walking",
          "Creature repair or automatic creature guidance",
          "Encyclopedia admission or BR13 constrained-get-up acceptance"
        ]
      }
    },
    "pose_recovery_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_planner_only",
        "profile_specific",
        "semantic_body_region_roles_required",
        "labeled_box_basis_required",
        "canonical_pose_set",
        "ambiguous_returns_unknown",
        "missing_anatomy_named_infeasible",
        "static_torque_gate_required",
        "static_power_gate_required",
        "structural_gate_required",
        "friction_gate_required",
        "reach_gate_required",
        "feasible_is_dynamic_execution_proof",
        "controller_present",
        "actuation_present",
        "command_wrench_or_joint_target_present",
        "contact_creation_or_maintenance_present",
        "external_assistance_present",
        "physical_recovery_present",
        "stance_handoff_present",
        "automatic_application_allowed",
        "automatic_creature_guidance_allowed"
      ],
      "properties": {
        "observer_planner_only": {
          "const": true
        },
        "profile_specific": {
          "const": true
        },
        "semantic_body_region_roles_required": {
          "const": true
        },
        "labeled_box_basis_required": {
          "const": true
        },
        "canonical_pose_set": {
          "const": [
            "upright",
            "prone",
            "supine",
            "left_side",
            "right_side"
          ]
        },
        "ambiguous_returns_unknown": {
          "const": true
        },
        "missing_anatomy_named_infeasible": {
          "const": true
        },
        "static_torque_gate_required": {
          "const": true
        },
        "static_power_gate_required": {
          "const": true
        },
        "structural_gate_required": {
          "const": true
        },
        "friction_gate_required": {
          "const": true
        },
        "reach_gate_required": {
          "const": true
        },
        "feasible_is_dynamic_execution_proof": {
          "const": false
        },
        "controller_present": {
          "const": false
        },
        "actuation_present": {
          "const": false
        },
        "command_wrench_or_joint_target_present": {
          "const": false
        },
        "contact_creation_or_maintenance_present": {
          "const": false
        },
        "external_assistance_present": {
          "const": false
        },
        "physical_recovery_present": {
          "const": false
        },
        "stance_handoff_present": {
          "const": false
        },
        "automatic_application_allowed": {
          "const": false
        },
        "automatic_creature_guidance_allowed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_root",
        "commit_sha",
        "clean_at_start",
        "clean_at_end",
        "campaign_path",
        "campaign_sha256",
        "source_inventory_sha256",
        "source_file_count",
        "br1_inventory_path",
        "br1_inventory_sha256",
        "br1_inventory_unchanged"
      ],
      "properties": {
        "repository_root": {
          "$ref": "#/$defs/path"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "clean_at_start": {
          "const": true
        },
        "clean_at_end": {
          "const": true
        },
        "campaign_path": {
          "$ref": "#/$defs/path"
        },
        "campaign_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "br1_inventory_path": {
          "$ref": "#/$defs/path"
        },
        "br1_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "br1_inventory_unchanged": {
          "const": true
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "sha256",
        "version",
        "fresh_target_process_invocations",
        "pid_recycle_events_recorded"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "const": "4.7.stable.mono.official.5b4e0cb0f"
        },
        "fresh_target_process_invocations": {
          "const": 10
        },
        "pid_recycle_events_recorded": {
          "const": true
        }
      }
    },
    "bundle_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema",
        "capsule_schema",
        "metrics_schema",
        "receipt_schema",
        "receipt_domain",
        "trust_mode"
      ],
      "properties": {
        "manifest_schema": {
          "const": "sporespore.lab.manifest.v1"
        },
        "capsule_schema": {
          "const": "sporespore.lab.br12_pose_recovery_evidence_capsule.v1"
        },
        "metrics_schema": {
          "const": "sporespore.lab.br12_pose_recovery_evidence_metrics.v1"
        },
        "receipt_schema": {
          "const": "sporespore.lab.publication_attestation.v1"
        },
        "receipt_domain": {
          "const": "sporespore.lab.publication_attestation.v1"
        },
        "trust_mode": {
          "const": "production"
        }
      }
    },
    "report_attestation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema",
        "receipt_domain",
        "trust_mode",
        "detached",
        "report_rewrite_after_attestation_forbidden"
      ],
      "properties": {
        "receipt_schema": {
          "const": "sporespore.lab.br12_certification_report_attestation.v1"
        },
        "receipt_domain": {
          "const": "sporespore.lab.br12_certification_report_attestation.v1"
        },
        "trust_mode": {
          "const": "production"
        },
        "detached": {
          "const": true
        },
        "report_rewrite_after_attestation_forbidden": {
          "const": true
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programs_required",
        "programs_passed",
        "replicates_per_program",
        "bundles_required",
        "bundles_passed",
        "assertions_required",
        "assertions_passed",
        "milestone_programs",
        "milestone_assertions",
        "supplementary_programs",
        "supplementary_assertions",
        "integrity_programs",
        "integrity_assertions"
      ],
      "properties": {
        "programs_required": {
          "const": 5
        },
        "programs_passed": {
          "const": 5
        },
        "replicates_per_program": {
          "const": 2
        },
        "bundles_required": {
          "const": 10
        },
        "bundles_passed": {
          "const": 10
        },
        "assertions_required": {
          "const": 150
        },
        "assertions_passed": {
          "const": 150
        },
        "milestone_programs": {
          "const": 4
        },
        "milestone_assertions": {
          "const": 122
        },
        "supplementary_programs": {
          "const": 0
        },
        "supplementary_assertions": {
          "const": 0
        },
        "integrity_programs": {
          "const": 1
        },
        "integrity_assertions": {
          "const": 28
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "programs_required",
        "programs_passed",
        "assertions_per_replicate",
        "status"
      ],
      "properties": {
        "cell_id": {
          "enum": [
            "BR12.0",
            "BR12.1",
            "BR12.2",
            "BR12.3"
          ]
        },
        "programs_required": {
          "type": "integer",
          "minimum": 1
        },
        "programs_passed": {
          "type": "integer",
          "minimum": 1
        },
        "assertions_per_replicate": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "pass"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "trust_mode",
        "key_id",
        "receipt_path",
        "receipt_sha256"
      ],
      "properties": {
        "valid": {
          "const": true
        },
        "trust_mode": {
          "const": "production"
        },
        "key_id": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_path": {
          "$ref": "#/$defs/path"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "replicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicate",
        "bundle_id",
        "bundle_path",
        "manifest_sha256",
        "checksums_sha256",
        "capsule_sha256",
        "metrics_sha256",
        "source_inventory_sha256",
        "containment_host_process_id",
        "target_process_id",
        "started_utc",
        "ended_utc",
        "assertions_passed",
        "assertion_labels_sha256",
        "transcript_sha256",
        "attestation"
      ],
      "properties": {
        "replicate": {
          "enum": [
            1,
            2
          ]
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_path": {
          "$ref": "#/$defs/path"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checksums_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capsule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metrics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "containment_host_process_id": {
          "type": "integer",
          "minimum": 1
        },
        "target_process_id": {
          "type": "integer",
          "minimum": 1
        },
        "started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ended_utc": {
          "type": "string",
          "format": "date-time"
        },
        "assertions_passed": {
          "type": "integer",
          "minimum": 1
        },
        "assertion_labels_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transcript_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attestation": {
          "$ref": "#/$defs/attestation"
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "source_identity_match",
        "assertion_count_match",
        "ordered_assertion_labels_match",
        "both_raw_transcripts_retained",
        "raw_transcript_identity_required"
      ],
      "properties": {
        "pass": {
          "const": true
        },
        "source_identity_match": {
          "const": true
        },
        "assertion_count_match": {
          "const": true
        },
        "ordered_assertion_labels_match": {
          "const": true
        },
        "both_raw_transcripts_retained": {
          "const": true
        },
        "raw_transcript_identity_required": {
          "const": false
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test",
        "expected_assertions",
        "claim_scope",
        "replicates",
        "reconciliation"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR12_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_role": {
          "enum": [
            "milestone",
            "supplementary",
            "integrity"
          ]
        },
        "test": {
          "type": "string",
          "pattern": "^test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        },
        "replicates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/replicate"
          }
        },
        "reconciliation": {
          "$ref": "#/$defs/reconciliation"
        }
      }
    },
    "final_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundles_required",
        "bundles_verified",
        "receipts_required",
        "receipts_verified",
        "source_inventories_verified",
        "metrics_verified",
        "target_process_invocations",
        "unique_target_processes",
        "pid_recycle_events",
        "complete_campaign"
      ],
      "properties": {
        "bundles_required": {
          "const": 10
        },
        "bundles_verified": {
          "const": 10
        },
        "receipts_required": {
          "const": 10
        },
        "receipts_verified": {
          "const": 10
        },
        "source_inventories_verified": {
          "const": 10
        },
        "metrics_verified": {
          "const": 10
        },
        "target_process_invocations": {
          "const": 10
        },
        "unique_target_processes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "pid_recycle_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "complete_campaign": {
          "const": true
        }
      }
    }
  }
}
