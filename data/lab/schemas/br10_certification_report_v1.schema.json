          "const": 0
        },
        "automatic_creature_guidance_allowed": {
          "const": false
        },
        "per_foot_measured_load_allocation": {
          "const": false
        },
        "scaffold_constrained_planar_reachable_catch": {
          "const": true
        },
        "paired_no_catch_control_improvement": {
          "const": true
        },
        "new_contact_catch_step": {
          "const": true
        },
        "free_3d_bracing": {
          "const": false
        },
        "free_3d_standing": {
          "const": false
        },
        "unconstrained_balance": {
          "const": false
        },
        "fall_arrest": {
          "const": false
        },
        "getting_up": {
          "const": false
        },
        "walking": {
          "const": false
        }
      }
