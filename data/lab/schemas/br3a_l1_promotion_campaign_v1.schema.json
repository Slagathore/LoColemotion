{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br3a_l1_promotion_campaign_v1.schema.json",
  "title": "SporeSpore BR3A L1 promotion campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "milestone_id",
    "claim_boundary",
    "process_policy",
    "source_policy",
    "br1_inventory_guard",
    "role_accounting",
    "programs",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br3a_l1_promotion_campaign.v1"
    },
    "campaign_id": {
      "const": "BR3A_L1_PROMOTION_CAMPAIGN_V1"
    },
    "campaign_version": {
      "const": 1
    },
    "milestone_id": {
      "const": "BR3A_L1_ENGINE_CONTACT_TRUTH"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the L1.0-L1.7 contact-engine observations named by the exact source-pinned programs. L1.8 and the knowledge guard are supplementary constraints. It establishes no articulated load-bearing limb, standing, bracing, fall arrest, getting up, walking, accepted knowledge, automatic creature guidance, or per-foot allocation of reconstructed whole-system load."
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_committed_source",
        "fresh_godot_process_per_replicate",
        "required_replicates_per_program",
        "pid_recycle_policy",
        "test_timeout_seconds",
        "complete_campaign_required",
        "cherry_pick_policy"
      ],
      "properties": {
        "clean_committed_source": {"const": true},
        "fresh_godot_process_per_replicate": {"const": true},
        "required_replicates_per_program": {"const": 2},
        "pid_recycle_policy": {"const": "allowed_only_for_nonoverlapping_completed_invocations_and_recorded"},
        "test_timeout_seconds": {"const": 300},
        "complete_campaign_required": {"const": true},
        "cherry_pick_policy": {"const": "forbidden_all_declared_runs_retained"}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "inventory_roots"],
      "properties": {
        "identity": {
          "const": "clean_git_commit_plus_exact_declared_byte_inventory_v1"
        },
        "inventory_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/inventory_root"}
        }
      }
    },
    "br1_inventory_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_path", "sha256", "test_count", "mutation_forbidden"],
      "properties": {
        "resource_path": {
          "const": "res://data/lab/campaigns/BR1_required_lab_tests_v2.json"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "test_count": {"const": 62},
        "mutation_forbidden": {"const": true}
      }
    },
    "role_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestone", "supplementary", "integrity", "total"],
      "properties": {
        "milestone": {"$ref": "#/$defs/role_count"},
        "supplementary": {"$ref": "#/$defs/role_count"},
        "integrity": {"$ref": "#/$defs/role_count"},
        "total": {"$ref": "#/$defs/role_count"}
      }
    },
    "programs": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/program"}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "extensions"],
      "properties": {
        "kind": {"enum": ["file", "tree"]},
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"pattern": "^\\.[a-z0-9]+$"}
        }
      }
    },
    "role_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programs", "assertions_per_replicate"],
      "properties": {
        "programs": {"type": "integer", "minimum": 1},
        "assertions_per_replicate": {"type": "integer", "minimum": 1}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test_resource_path",
        "expected_assertions",
        "claim_scope"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR3A_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "enum": [
            "L1.0", "L1.1", "L1.2", "L1.3", "L1.4", "L1.5",
            "L1.6", "L1.7", "L1.8", "BR3A_INTEGRITY"
          ]
        },
        "evidence_role": {
          "enum": ["milestone", "supplementary", "integrity"]
        },
        "test_resource_path": {
          "type": "string",
          "pattern": "^res://tests/test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
