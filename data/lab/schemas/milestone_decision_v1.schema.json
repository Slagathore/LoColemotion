{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/milestone_decision_v1.schema.json",
  "title": "SporeSpore milestone decision v1",
  "description": "An append-only human acceptance or rejection of one narrowly bounded research milestone, tied to exact machine evidence without broadening the source evidence claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "milestone_id",
    "decision_revision",
    "status",
    "decided_by",
    "decided_utc",
    "evidence_basis",
    "accepted_contracts",
    "accepted_capabilities",
    "claim_boundary",
    "excluded_capabilities",
    "downstream_open",
    "supersedes"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.milestone_decision.v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+_DECISION_V[0-9]+$"
    },
    "milestone_id": {
      "type": "string",
      "pattern": "^BR[0-9]+(?:\\.[0-9]+)?(?:[A-Z])?(?:_[A-Z0-9_]+)?$"
    },
    "decision_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["accepted", "rejected", "retired"]
    },
    "decided_by": {
      "$ref": "#/$defs/decider"
    },
    "decided_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_basis": {
      "$ref": "#/$defs/evidence_basis"
    },
    "accepted_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*_v[0-9]+$"
      }
    },
    "accepted_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "excluded_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downstream_open": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+_DECISION_V[0-9]+$"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "decider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority", "decision_channel"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "const": "project_decider"
        },
        "decision_channel": {
          "const": "direct_conversation"
        }
      }
    },
    "evidence_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_id",
        "certification_contract_id",
        "certification_claim_boundary",
        "report_schema",
        "report_sha256",
        "report_bytes",
        "report_locator",
        "receipt_schema",
        "receipt_sha256",
        "receipt_locator",
        "source_commit_sha",
        "test_inventory_sha256",
        "tests_required",
        "test_artifacts_required",
        "tests_passed",
        "cells_passed",
        "bundles_passed",
        "replays_passed",
        "replicate_comparisons_passed",
        "final_readbacks_passed",
        "production_attestation_verified"
      ],
      "properties": {
        "certification_id": {
          "type": "string",
          "pattern": "^br1_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{8}$"
        },
        "certification_contract_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "certification_claim_boundary": {
          "type": "string",
          "minLength": 1
        },
        "report_schema": {
          "type": "string",
          "pattern": "^sporespore\\.lab\\.br1_certification_report\\.v[0-9]+$"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "report_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "report_locator": {
          "type": "string",
          "pattern": "^LabEvidence/BR1/[A-Za-z0-9_./-]+$"
        },
        "receipt_schema": {
          "type": "string",
          "pattern": "^sporespore\\.lab\\.br1_certification_report_attestation\\.v[0-9]+$"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_locator": {
          "type": "string",
          "pattern": "^LabTrust/v1/certification_reports_v[0-9]+/receipts/[a-f0-9]{64}\\.json$"
        },
        "source_commit_sha": {
          "$ref": "#/$defs/git_sha1"
        },
        "test_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tests_required": {
          "type": "integer",
          "minimum": 1
        },
        "test_artifacts_required": {
          "type": "integer",
          "minimum": 2
        },
        "tests_passed": {
          "type": "integer",
          "minimum": 1
        },
        "cells_passed": {
          "type": "integer",
          "minimum": 1
        },
        "bundles_passed": {
          "type": "integer",
          "minimum": 1
        },
        "replays_passed": {
          "type": "integer",
          "minimum": 1
        },
        "replicate_comparisons_passed": {
          "type": "integer",
          "minimum": 1
        },
        "final_readbacks_passed": {
          "type": "integer",
          "minimum": 1
        },
        "production_attestation_verified": {
          "const": true
        }
      }
    }
  }
}
