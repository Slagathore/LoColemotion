{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br12_pose_recovery_promotion_campaign_v1.schema.json",
  "title": "SporeSpore BR12 pose and recovery-feasibility promotion campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "milestone_id",
    "claim_boundary",
    "process_policy",
    "source_policy",
    "br1_inventory_guard",
    "role_accounting",
    "programs",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br12_pose_recovery_promotion_campaign.v1"
    },
    "campaign_id": {
      "const": "BR12_POSE_RECOVERY_PROMOTION_CAMPAIGN_V1"
    },
    "campaign_version": {
      "const": 1
    },
    "milestone_id": {
      "const": "BR12_POSE_AND_RECOVERY_FEASIBILITY"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the exact source-pinned BR12.0 semantic body-region contact-role registry and labeled-box basis-oracle scope; BR12.1 deterministic profile-specific canonical-pose classifier scope; BR12.2 semantic anatomy-role recovery-profile matching scope; and BR12.3 conservative static torque, power, structural, friction, and reach feasibility scope. BR12.4 is integrity-only containment and cannot substitute for a milestone program. The BR12 claim boundary is verbatim: BR12 is observer/planner truth only. It classifies only declared labeled-box canonical poses, preserves ambiguous or invalid evidence as unknown, names missing anatomy, and reports whether one exact profile passes preregistered static inequalities before actuation. A feasible report is not dynamic execution evidence. No BR12 program contains a recovery controller, emits an actuator command, wrench, or joint target, creates or maintains contact, applies external assistance, raises a body, hands off to stance, repairs a creature, or guides one automatically. It establishes no physical self-righting or getting up, free-3D standing or bracing, generalized recovery, gait, or walking."
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_committed_source",
        "fresh_godot_process_per_replicate",
        "required_replicates_per_program",
        "pid_recycle_policy",
        "test_timeout_seconds",
        "complete_campaign_required",
        "cherry_pick_policy"
      ],
      "properties": {
        "clean_committed_source": {
          "const": true
        },
        "fresh_godot_process_per_replicate": {
          "const": true
        },
        "required_replicates_per_program": {
          "const": 2
        },
        "pid_recycle_policy": {
          "const": "allowed_only_for_nonoverlapping_completed_invocations_and_recorded"
        },
        "test_timeout_seconds": {
          "const": 300
        },
        "complete_campaign_required": {
          "const": true
        },
        "cherry_pick_policy": {
          "const": "forbidden_all_declared_runs_retained"
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "inventory_roots"
      ],
      "properties": {
        "identity": {
          "const": "clean_git_commit_plus_exact_declared_byte_inventory_v1"
        },
        "inventory_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inventory_root"
          }
        }
      }
    },
    "br1_inventory_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_path",
        "sha256",
        "test_count",
        "mutation_forbidden"
      ],
      "properties": {
        "resource_path": {
          "const": "res://data/lab/campaigns/BR1_required_lab_tests_v2.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "test_count": {
          "const": 62
        },
        "mutation_forbidden": {
          "const": true
        }
      }
    },
    "role_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone",
        "supplementary",
        "integrity",
        "total"
      ],
      "properties": {
        "milestone": {
          "$ref": "#/$defs/milestone_role_count"
        },
        "supplementary": {
          "$ref": "#/$defs/zero_role_count"
        },
        "integrity": {
          "$ref": "#/$defs/integrity_role_count"
        },
        "total": {
          "$ref": "#/$defs/total_role_count"
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Physical self-righting or getting up",
          "Dynamic recovery execution or stance handoff",
          "Controller, actuator, wrench, or joint-target authority",
          "Contact creation, maintenance, or external assistance",
          "Generalization beyond the exact labeled-box bases, pose profiles, anatomy roles, and thresholds",
          "Free 3D standing, bracing, recovery, or unconstrained balance",
          "Per-contact, per-body, per-foot, or per-toe measured load allocation",
          "Gait, candidate walking, or walking",
          "Creature repair or automatic creature guidance",
          "Encyclopedia admission or BR13 constrained-get-up acceptance"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "extensions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "tree"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^\\.[a-z0-9]+$"
          }
        }
      }
    },
    "role_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programs",
        "assertions_per_replicate"
      ],
      "properties": {
        "programs": {
          "type": "integer",
          "minimum": 0
        },
        "assertions_per_replicate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "milestone_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 4
            },
            "assertions_per_replicate": {
              "const": 61
            }
          }
        }
      ]
    },
    "zero_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 0
            },
            "assertions_per_replicate": {
              "const": 0
            }
          }
        }
      ]
    },
    "integrity_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 1
            },
            "assertions_per_replicate": {
              "const": 14
            }
          }
        }
      ]
    },
    "total_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 5
            },
            "assertions_per_replicate": {
              "const": 75
            }
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test_resource_path",
        "expected_assertions",
        "claim_scope"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR12_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "enum": [
            "BR12.0",
            "BR12.1",
            "BR12.2",
            "BR12.3",
            "BR12.4"
          ]
        },
        "evidence_role": {
          "enum": [
            "milestone",
            "supplementary",
            "integrity"
          ]
        },
        "test_resource_path": {
          "type": "string",
          "pattern": "^res://tests/test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
