{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br4_l2_promotion_campaign_v1.schema.json",
  "title": "SporeSpore BR4 L2 promotion campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "milestone_id",
    "claim_boundary",
    "process_policy",
    "source_policy",
    "br1_inventory_guard",
    "role_accounting",
    "programs",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br4_l2_promotion_campaign.v1"
    },
    "campaign_id": {
      "const": "BR4_L2_PROMOTION_CAMPAIGN_V1"
    },
    "campaign_version": {
      "const": 1
    },
    "milestone_id": {
      "const": "BR4_L2_JOINT_ACTUATOR_TRUTH"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the exact L2.0-L2.7 joint-actuator observations named by the source-pinned programs. Fixed scaffolds, free roots, actuator envelopes, hard-limit reactions, two-joint behavior, and anchor-observer failures retain their declared fixture scopes. It establishes no contact-bearing articulated limb, per-foot or per-contact load allocation, standing, bracing, fall arrest, getting up, gait, walking, accepted knowledge, or automatic creature guidance."
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_committed_source",
        "fresh_godot_process_per_replicate",
        "required_replicates_per_program",
        "pid_recycle_policy",
        "test_timeout_seconds",
        "complete_campaign_required",
        "cherry_pick_policy"
      ],
      "properties": {
        "clean_committed_source": {"const": true},
        "fresh_godot_process_per_replicate": {"const": true},
        "required_replicates_per_program": {"const": 2},
        "pid_recycle_policy": {"const": "allowed_only_for_nonoverlapping_completed_invocations_and_recorded"},
        "test_timeout_seconds": {"const": 300},
        "complete_campaign_required": {"const": true},
        "cherry_pick_policy": {"const": "forbidden_all_declared_runs_retained"}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "inventory_roots"],
      "properties": {
        "identity": {
          "const": "clean_git_commit_plus_exact_declared_byte_inventory_v1"
        },
        "inventory_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/inventory_root"}
        }
      }
    },
    "br1_inventory_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_path", "sha256", "test_count", "mutation_forbidden"],
      "properties": {
        "resource_path": {
          "const": "res://data/lab/campaigns/BR1_required_lab_tests_v2.json"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "test_count": {"const": 62},
        "mutation_forbidden": {"const": true}
      }
    },
    "role_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestone", "supplementary", "integrity", "total"],
      "properties": {
        "milestone": {"$ref": "#/$defs/milestone_role_count"},
        "supplementary": {"$ref": "#/$defs/zero_role_count"},
        "integrity": {"$ref": "#/$defs/zero_role_count"},
        "total": {"$ref": "#/$defs/milestone_role_count"}
      }
    },
    "programs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/program"}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "A contact-bearing articulated limb, foot, or creature",
          "Per-contact, per-foot, or per-toe load allocation",
          "Standing, bracing, or fall arrest",
          "Self-righting or getting up",
          "Gait, candidate walking, or walking",
          "Continuous endurance, fatigue, or thermal capacity",
          "A hard-limit reaction as available muscle strength",
          "Accepted encyclopedia knowledge or automatic creature guidance"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "extensions"],
      "properties": {
        "kind": {"enum": ["file", "tree"]},
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"pattern": "^\\.[a-z0-9]+$"}
        }
      }
    },
    "role_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programs", "assertions_per_replicate"],
      "properties": {
        "programs": {"type": "integer", "minimum": 0},
        "assertions_per_replicate": {"type": "integer", "minimum": 0}
      }
    },
    "milestone_role_count": {
      "allOf": [
        {"$ref": "#/$defs/role_count"},
        {
          "properties": {
            "programs": {"const": 8},
            "assertions_per_replicate": {"const": 131}
          }
        }
      ]
    },
    "zero_role_count": {
      "allOf": [
        {"$ref": "#/$defs/role_count"},
        {
          "properties": {
            "programs": {"const": 0},
            "assertions_per_replicate": {"const": 0}
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test_resource_path",
        "expected_assertions",
        "claim_scope"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR4_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "enum": [
            "L2.0", "L2.1", "L2.2", "L2.3", "L2.4", "L2.5",
            "L2.6", "L2.7"
          ]
        },
        "evidence_role": {
          "enum": ["milestone", "supplementary", "integrity"]
        },
        "test_resource_path": {
          "type": "string",
          "pattern": "^res://tests/test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
