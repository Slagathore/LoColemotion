        "pose_teleport_enabled",
        "semantic_protective_role_required",
        "semantic_core_role_required",
        "protective_contact_before_core_required",
        "same_initial_state_control_required",
        "zero_command_control_required",
        "centroidal_angular_momentum_required",
        "reconstructed_external_impulse_required",
        "mechanical_energy_accounting_required",
        "severity_proxy",
        "severity_proxy_is_injury_model",
        "local_core_load_is_generalized_allocation",
        "finite_paired_hinge_actuator_required",
        "actuator_spec_digest_bound",
        "command_receipt_and_capacity_reconciliation",
        "stable_fallen_terminal_required",
        "upright_recovery_required",
        "scaffold_constrained_planar_controlled_fall_established",
        "actuator_saturation_allowed"
