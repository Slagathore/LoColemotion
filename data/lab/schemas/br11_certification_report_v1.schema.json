  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_root",
        "commit_sha",
        "clean_at_start",
        "clean_at_end",
        "campaign_path",
        "campaign_sha256",
        "source_inventory_sha256",
        "source_file_count",
        "br1_inventory_path",
        "br1_inventory_sha256",
        "br1_inventory_unchanged"
