        "sagittal_x_y_translation_released": {
          "const": true
        },
        "pitch_released": {
          "const": true
        },
        "out_of_plane_translation_locked": {
          "const": true
        },
        "roll_and_yaw_locked": {
          "const": true
        },
        "guide_motors_or_springs_enabled": {
          "const": false
        },
        "built_in_joint_motors_enabled": {
          "const": false
        },
        "joint_limits_enabled": {
          "const": false
        },
        "passive_tissues_enabled": {
          "const": false
