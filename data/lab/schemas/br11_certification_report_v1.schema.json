{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br11_certification_report_v1.schema.json",
  "title": "SporeSpore BR11 certification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "certification",
    "certification_id",
    "milestone_id",
    "claim_boundary",
    "generated_utc",
    "source",
    "engine",
    "bundle_policy",
    "report_attestation_policy",
    "accounting",
    "cells",
    "programs",
    "final_readback",
    "controlled_fall_constraints",
    "capabilities",
    "does_not_establish"
