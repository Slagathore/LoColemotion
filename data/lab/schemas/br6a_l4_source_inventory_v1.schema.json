{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br6a_l4_source_inventory_v1.schema.json",
  "title": "SporeSpore BR6A L4 exact source inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "commit_sha", "algorithm", "file_count", "files"],
  "properties": {
    "schema": {"const": "sporespore.lab.br6a_l4_source_inventory.v1"},
    "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "algorithm": {"const": "sha256"},
    "file_count": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
