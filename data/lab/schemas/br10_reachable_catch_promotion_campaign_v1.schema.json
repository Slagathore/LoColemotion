{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br10_reachable_catch_promotion_campaign_v1.schema.json",
  "title": "SporeSpore BR10 reachable planar catch promotion campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "campaign_version",
    "milestone_id",
    "claim_boundary",
    "process_policy",
    "source_policy",
    "br1_inventory_guard",
    "role_accounting",
    "programs",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br10_reachable_catch_promotion_campaign.v1"
    },
    "campaign_id": {
      "const": "BR10_REACHABLE_CATCH_PROMOTION_CAMPAIGN_V1"
    },
    "campaign_version": {
      "const": 1
    },
    "milestone_id": {
      "const": "BR10_REACHABLE_PLANAR_CATCH"
    },
    "claim_boundary": {
      "const": "This campaign can certify only the exact source-pinned BR10.0 deterministic reachable-catch planning scope; BR10.1 observed SEARCH-to-TOUCH-to-LOAD-to-BEARING phase-authority scope; BR10.2 strict sagittal tangent/normal J-transpose force-map scope; and BR10.3 paired active-catch and no-catch-control Godot/Jolt scope. BR10.4 is integrity-only containment and cannot substitute for a milestone program. The BR10.3 analyzer boundary is verbatim: BR10 paired reachable new-contact catch step on the exact inherited BR7 sagittal scaffold: one no-catch control and one active-catch world; one material unpowered out-of-plane guide with in-plane X/Y translation and pitch released; four passive hinges driven only through paired finite joint actuators; one ordinary left distal contact bearing at the declared disturbance while the observed right distal sphere is unloaded and clear; one preparation-only root freeze released exactly with one declared pitch impulse; one deterministic support-expanding plan selected on the first post-disturbance observation; finite swing commands to a world target; observed SEARCH to TOUCH to LOAD to BEARING authority; bounded normal-load rate and friction-reserved sagittal tangent commands mapped through an explicit J-transpose contract; full command-ledger, executor, receipt, and contact-capacity reconciliation; measured support-interval expansion; and a post-catch world-target/posture handoff that retains ordinary contacts through the complete horizon. Commanded contact-force shares are not measured per-foot loads. The positive result establishes only this scaffold-constrained planar reachable catch step and return to the declared stance dwell relative to its matched no-catch crash control. It establishes no per-foot measured load allocation, free-3D standing or bracing, general articulated load-bearing limb, generalized fall arrest, getting up, gait, walking, creature repair, or automatic creature guidance."
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_committed_source",
        "fresh_godot_process_per_replicate",
        "required_replicates_per_program",
        "pid_recycle_policy",
        "test_timeout_seconds",
        "complete_campaign_required",
        "cherry_pick_policy"
      ],
      "properties": {
        "clean_committed_source": {
          "const": true
        },
        "fresh_godot_process_per_replicate": {
          "const": true
        },
        "required_replicates_per_program": {
          "const": 2
        },
        "pid_recycle_policy": {
          "const": "allowed_only_for_nonoverlapping_completed_invocations_and_recorded"
        },
        "test_timeout_seconds": {
          "const": 300
        },
        "complete_campaign_required": {
          "const": true
        },
        "cherry_pick_policy": {
          "const": "forbidden_all_declared_runs_retained"
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "inventory_roots"
      ],
      "properties": {
        "identity": {
          "const": "clean_git_commit_plus_exact_declared_byte_inventory_v1"
        },
        "inventory_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/inventory_root"
          }
        }
      }
    },
    "br1_inventory_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_path",
        "sha256",
        "test_count",
        "mutation_forbidden"
      ],
      "properties": {
        "resource_path": {
          "const": "res://data/lab/campaigns/BR1_required_lab_tests_v2.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "test_count": {
          "const": 62
        },
        "mutation_forbidden": {
          "const": true
        }
      }
    },
    "role_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone",
        "supplementary",
        "integrity",
        "total"
      ],
      "properties": {
        "milestone": {
          "$ref": "#/$defs/milestone_role_count"
        },
        "supplementary": {
          "$ref": "#/$defs/zero_role_count"
        },
        "integrity": {
          "$ref": "#/$defs/integrity_role_count"
        },
        "total": {
          "$ref": "#/$defs/total_role_count"
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/program"
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Per-contact, per-foot, or per-toe measured load allocation",
          "Free 3D standing or unconstrained balance",
          "Free 3D or unscaffolded bracing",
          "An absent, negligible, or measured out-of-plane scaffold reaction",
          "Articulated-limb, morphology, terrain, complex-foot, or endurance generalization",
          "Generalized fall arrest",
          "Self-righting or getting up",
          "Gait, candidate walking, or walking",
          "Creature repair, accepted encyclopedia knowledge, or automatic creature guidance"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inventory_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "extensions"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "tree"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*)(?:/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*|\\.[A-Za-z0-9_-][A-Za-z0-9_.-]*))*$"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^\\.[a-z0-9]+$"
          }
        }
      }
    },
    "role_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programs",
        "assertions_per_replicate"
      ],
      "properties": {
        "programs": {
          "type": "integer",
          "minimum": 0
        },
        "assertions_per_replicate": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "milestone_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 4
            },
            "assertions_per_replicate": {
              "const": 56
            }
          }
        }
      ]
    },
    "zero_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 0
            },
            "assertions_per_replicate": {
              "const": 0
            }
          }
        }
      ]
    },
    "integrity_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 1
            },
            "assertions_per_replicate": {
              "const": 35
            }
          }
        }
      ]
    },
    "total_role_count": {
      "allOf": [
        {
          "$ref": "#/$defs/role_count"
        },
        {
          "properties": {
            "programs": {
              "const": 5
            },
            "assertions_per_replicate": {
              "const": 91
            }
          }
        }
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "cell_id",
        "evidence_role",
        "test_resource_path",
        "expected_assertions",
        "claim_scope"
      ],
      "properties": {
        "program_id": {
          "type": "string",
          "pattern": "^BR10_[A-Z0-9_]+_V1$"
        },
        "cell_id": {
          "enum": [
            "BR10.0",
            "BR10.1",
            "BR10.2",
            "BR10.3",
            "BR10.4"
          ]
        },
        "evidence_role": {
          "enum": [
            "milestone",
            "supplementary",
            "integrity"
          ]
        },
        "test_resource_path": {
          "type": "string",
          "pattern": "^res://tests/test_(?:lab|experimental)_[A-Za-z0-9_.-]+\\.gd$"
        },
        "expected_assertions": {
          "type": "integer",
          "minimum": 1
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
