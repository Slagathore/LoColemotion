{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/br7_knowledge_admission_manifest_v1.schema.json",
  "title": "SporeSpore BR7 observation-only knowledge admission manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "status",
    "authorized_by",
    "authorization_basis",
    "authorization_instruction",
    "decision",
    "guidance_policy",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "sporespore.lab.br7_knowledge_admission_manifest.v1"
    },
    "manifest_id": {
      "const": "BR7_PLANAR_KNOWLEDGE_ADMISSION_V1"
    },
    "status": {
      "const": "authorized"
    },
    "authorized_by": {
      "const": "Cole"
    },
    "authorization_basis": {
      "const": "standing_authority_to_admit_recommended_observation_only_br7_knowledge"
    },
    "authorization_instruction": {
      "const": "continue from here to as far as you can. dont stop for reports. you know i trust in your recommendations."
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "guidance_policy": {
      "$ref": "#/$defs/guidance_policy"
    },
    "entries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,159}$"
    },
    "unique_strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_sha256"],
      "properties": {
        "decision_id": {
          "const": "BR7_PLANAR_MULTI_CONTACT_STANCE_DECISION_V1"
        },
        "decision_sha256": {
          "const": "sha256:ecd2528d6d766e137b6f69272054a455f047d97befd268ca2989399df3b9aa41"
        }
      }
    },
    "guidance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "automatic_creature_guidance_allowed",
        "automatic_application_allowed",
        "unlock_requires"
      ],
      "properties": {
        "mode": {
          "const": "observation_only"
        },
        "automatic_creature_guidance_allowed": {
          "const": false
        },
        "automatic_application_allowed": {
          "const": false
        },
        "unlock_requires": {
          "const": [
            "ACCEPTED_FREE_3D_STANCE_MILESTONE",
            "VALIDATED_PER_CONTACT_LOAD_MEASUREMENT",
            "SEPARATE_GUIDANCE_DECISION"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "cell_id",
        "knowledge_class",
        "output_name",
        "program_id",
        "authoring"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/stable_id"
        },
        "cell_id": {
          "enum": ["BR7.0", "BR7.1", "BR7.2", "BR7.3"]
        },
        "knowledge_class": {
          "const": "milestone_observation"
        },
        "output_name": {
          "type": "string",
          "pattern": "^br7_[0-3]_[a-z0-9_]+\\.v1\\.json$"
        },
        "program_id": {
          "pattern": "^BR7_PLANAR_[0-3]_[A-Z0-9_]+_V1$"
        },
        "authoring": {
          "$ref": "#/$defs/authoring"
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "claim",
        "scope",
        "mechanism",
        "applicability",
        "failure_boundaries",
        "morphology_tags",
        "parameter_effects",
        "unknowns",
        "supersedes"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "applicability": {
          "$ref": "#/$defs/unique_strings"
        },
        "failure_boundaries": {
          "allOf": [
            {
              "$ref": "#/$defs/unique_strings"
            },
            {
              "minItems": 1
            }
          ]
        },
        "morphology_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          },
          "uniqueItems": true
        },
        "parameter_effects": {
          "type": "array",
          "maxItems": 0
        },
        "unknowns": {
          "$ref": "#/$defs/unique_strings"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
