{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporespore.local/schemas/lab/child_run_index_v1.schema.json",
  "title": "SporeSpore campaign child-run index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "children"],
  "properties": {
    "schema": {"const": "sporespore.lab.child_run_index.v1"},
    "campaign_id": {"$ref": "#/$defs/stable_id"},
    "children": {
      "type": "array",
      "items": {"$ref": "#/$defs/child"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "run_id", "manifest_sha256", "policy"],
      "properties": {
        "cell_id": {"$ref": "#/$defs/stable_id"},
        "run_id": {"$ref": "#/$defs/stable_id"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "policy": {
          "enum": [
            "required_feasible",
            "expected_infeasible",
            "exploratory"
          ]
        }
      }
    }
  }
}
