      "output_name": "br3a_l1_0_contact_observer_foundation.v1.json",
      "program_ids": [
        "BR3A_L1_0_CONTACT_POSITION_FRAME_V1",
        "BR3A_L1_0_CONTACT_NORMAL_SIGN_V1",
        "BR3A_L1_0_CONTACT_BUFFER_SATURATION_V1",
