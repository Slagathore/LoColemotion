        "BR3A_L1_0_EXTERNAL_CONTACT_DEDUP_V1",
        "BR3A_L1_0_SELF_CONTACT_EXCLUSION_V1",
        "BR3A_L1_0_SUPPORT_GEOMETRY_V1",
        "BR3A_L1_0_CONTACT_SUPPORT_STATE_V1"
      ],
      "authoring": {
        "kind": "inline",
        "title": "Contact observation preserves declared frames, signs, capacity refusal, lifetime, identity, and qualified support geometry",
        "claim": "Across the exact eight certified L1.0 programs, contact positions retain their declared world and local frame identities; normal and impulse signs are explicit; contact-cap saturation is observable and fails closed; contact lifetime preserves start, continuation, and end identity; mirrored external observations deduplicate without losing identity; self-contact is excluded from external support; support geometry distinguishes point, segment, and polygon cases; and support state is derived only from qualified external-contact evidence.",
        "scope": "Only the exact L1.0 released-suite fixtures, contracts, source commit, and program claim scopes identified by BR3A certification br3a_20260723T050201Z_109cc664.",
        "mechanism": "The observer carries explicit coordinate-frame and counterparty identity, rejects over-capacity observations instead of truncating them, tracks contact identity across frames, and derives support geometry and support state only after external-contact qualification.",
        "applicability": [
          "Validating contact-observer plumbing before dynamic joint or support experiments",
          "Rejecting self-contact and saturated observations as external support evidence",
          "Providing point, segment, and polygon support geometry to later bounded analyses"
        ],
        "failure_boundaries": [
          "Does not establish exact continuous contact force or per-contact load allocation",
          "Does not establish an articulated load-bearing joint, foot, limb, or creature",
          "Does not establish standing, bracing, fall arrest, getting up, gait, or walking"
        ],
        "morphology_tags": [
          "body_agnostic",
          "contact_observer",
          "jolt"
        ],
        "parameter_effects": [],
        "unknowns": [
          "How the observer behaves under future articulated high-contact-count fixtures beyond the certified programs",
          "How aggregate external load can be allocated among multiple simultaneous support contacts"
        ],
        "supersedes": []
      }
    },
