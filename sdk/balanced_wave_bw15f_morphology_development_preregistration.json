  "mechanism_hypothesis": {
    "problem": "BW14V-B saturated its full 0.30-rad desired-minus-measured correction in every cell and degraded forward motion, torso height, and tilt in every matched cell.",
    "hypothesis": "A global small-gain forward-velocity correction can distinguish the legacy error orientation from the mechanically opposed orientation without morphology-specific branches; if the opposed orientation is useful, a second global gain tests whether its effect increases within a prospectively bounded small-gain interval.",
    "factorial_interpretation": {
      "a_to_b": "mechanism_on_at_one_tenth_bw14v_gain_with_legacy_orientation",
      "b_to_c": "error_orientation_only_at_fixed_0_03_rad_gain",
      "c_to_d": "gain_only_with_fixed_measured_minus_desired_orientation"
    },
    "desired_velocity_source": "motion_command.desired_planar_velocity_task_m_s.x",
    "measured_velocity_source": "dot(state.base_twist_world.linear_velocity_m_s, task_frame.forward_axis_world_unit)",
    "desired_minus_measured_formula": "clamp((desired-measured)/abs(desired),-1,1); exact_zero_when_abs(desired)<=1e-12",
    "measured_minus_desired_formula": "-clamp((desired-measured)/abs(desired),-1,1); exact_zero_when_abs(desired)<=1e-12",
    "gain_values_rad": [0.0, 0.03, 0.06],
    "gain_basis": "0.03_is_one_tenth_of_the_falsified_bw14v_cap;0.06_is_two_times_the_prospective_small_gain_unit",
    "cycle_envelope": "unchanged_bw14v_smoothstep_swing_and_one_minus_smoothstep_stance",
    "phase_factor_varied": false,
    "phase_experiment_requires_a_distinct_future_identity_if_no_treatment_wins": true,
