  "diagnosis": {
    "classification": "rapier_actuator_fixture_invalid_zero_angular_inertia",
    "observed_source_pattern": "The Rapier actuator child used RigidBodyBuilder::additional_mass(1.0) with a cuboid collider whose mass was explicitly 0.0.",
    "rapier_0_34_semantics": "Rigid-body mass properties begin at zero. Collider contributions are accumulated first. RigidBodyAdditionalMassProps::Mass then calls set_mass(new_mass, true), which rescales existing angular inertia; a zero-density collider supplied zero inertia, so the resulting principal angular inertia stayed zero.",
    "why_zero_angle_is_expected": "Rapier treats zero angular inertia as infinite rotational inertia, so the revolute motor could not rotate the child even though translational mass was nonzero.",
