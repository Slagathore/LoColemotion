        "route": "replace_hinge_motor_with_paired_direct_body_torques",
        "reason": "That changes the published actuator profile and cannot qualify the existing R24D1/R24D2 semantics."
      },
      {
        "route": "outer_step_relative_rate_times_total_motor_impulse",
        "reason": "Other sequential impulses can be interleaved between motor iterations, so outer endpoints do not isolate motor-attributed work."
      },
      {
        "route": "subtree_momentum_reconstruction",
        "reason": "A moving articulated subtree with contacts, limits, damping, and a moving pivot requires a separately qualified oracle and is not the minimal exact source available here."
