  "observer_definition": {
    "ordered_dynamic_body_count": 9,
    "force_velocity_equation": "velocity_after_gravity_force_world_m_s = pre_boundary_linear_velocity_world_m_s + total_gravity_world_m_s2 * solver_step_s",
    "force_kinetic_exchange_equation": "sum_over_bodies(0.5 * mass_kg * (squared_norm(velocity_after_gravity_force_world_m_s) - squared_norm(pre_boundary_linear_velocity_world_m_s)))",
    "whole_step_mass_weighted_displacement_equation": "sum_over_bodies(mass_kg * (post_boundary_position_world_m - pre_boundary_position_world_m))",
    "position_integration_mass_weighted_displacement_equation": "whole_step_mass_weighted_displacement_kg_m - source_measured_position_constraint_mass_weighted_displacement_kg_m",
    "position_integration_potential_exchange_equation": "negative_uniform_total_gravity_world_m_s2_dot_position_integration_mass_weighted_displacement_kg_m",
    "signed_discrete_staging_exchange_equation": "force_integration_kinetic_exchange_j + position_integration_potential_exchange_j",
    "whole_step_mechanical_energy_change_used_as_input": false,
