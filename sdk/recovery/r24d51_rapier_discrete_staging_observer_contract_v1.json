    "native_force_boundary": "aggregate_supported_solver_body_kinetic_energy_immediately_before_and_after_force_derived_velocity_increments_are_added_at_each_small_step",
    "force_integration_kinetic_exchange_formula": "sum_over_ordered_small_steps_of_kinetic_energy_after_force_minus_kinetic_energy_before_force",
    "raw_gravity_potential_formula": "negative_sum_over_supported_dynamic_bodies_of_mass_times_gravity_scale_times_gravity_dot_world_center_of_mass",
