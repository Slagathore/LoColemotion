    "rapier_endpoint_potential_formula": "raw_gravity_potential_plus_mass_times_gravity_scale_times_gravity_dot_linear_velocity_times_outer_timestep_divided_by_two",
    "endpoint_half_step_projection_exchange_formula": "aggregate_endpoint_half_step_projection_after_outer_step_minus_before_outer_step",
    "signed_discrete_staging_exchange_formula": "force_integration_kinetic_exchange_plus_raw_gravity_potential_position_exchange_plus_endpoint_half_step_projection_exchange",
    "small_step_population_required": 16,
