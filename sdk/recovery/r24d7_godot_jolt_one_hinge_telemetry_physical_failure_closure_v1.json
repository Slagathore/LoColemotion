    "classification": "implementation_invalid_timing_control_callback_dispatched_after_space_step",
    "frozen_probe_claim": "called from _integrate_forces(), while Jolt owns the stepping space.",
    "frozen_probe_method": "func _integrate_forces(_state: PhysicsDirectBodyState3D) -> void:",
    "frozen_control_requirement": "read_during_integrate_forces_must_return_null",
