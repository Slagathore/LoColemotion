  "measurement_design": {
    "profile_id": "mujoco_direct_velocity_servo_implicit_step_work_v3",
    "implementation_path": "sdk/adapters/mujoco/sporespore_mujoco_adapter/implicit_step_energy.py",
    "reported_pre_force_identity": "MjData.actuator_force after forward actuation and before the implicit velocity update",
    "reported_pre_generalized_force_identity": "MjData.qfrc_actuator and MjData.qfrc_constraint at the same pre-integration forward-dynamics stage",
    "velocity_identity": "copied MjData.qvel immediately before mj_step2 and immediately after mj_step2 for every native substep",
    "actuator_moment_identity": "the retained pre-step MjData.actuator_moment transmission matrix",
    "effective_force_formula": "reported_pre_force + source_defined_velocity_derivative * (post_actuator_velocity - pre_actuator_velocity)",
    "unsaturated_derivative": "minus_velocity_gain",
    "saturated_derivative": 0.0,
    "effective_actuator_work_formula": "dot(effective_implicit_actuator_force, midpoint_pre_post_actuator_velocity) * native_timestep",
    "effective_generalized_actuator_work_formula": "dot(transpose(actuator_moment) * effective_implicit_actuator_force, midpoint_pre_post_generalized_velocity) * native_timestep",
    "centered_constraint_work_formula": "dot(reported_pre_generalized_constraint_force, midpoint_pre_post_generalized_velocity) * native_timestep",
    "left_endpoint_v2_terms_retained": true,
    "effective_matched_zero_actuator_work_retained": true,
    "actuator_and_generalized_work_crosscheck_required": true,
    "binary64_crosscheck_ulp_budget": 8,
    "binary64_budget_provenance": "Inherited from the qualified public MuJoCo actuator-cap mapping's deterministic binary64 rounding budget; it is a representation check, not a behavior threshold or empirical margin.",
    "mechanical_energy_change_used_as_input": false,
    "balance_residual_used_as_input": false,
    "acceptance_threshold_used_as_input": false
  },
  "adequacy_and_limit_argument": {
    "algebraic_adequacy": "For implicitfast without the excluded passive derivatives, multiplying the solved velocity increment by M gives timestep times the reported force plus its qualified velocity derivative times the same increment. The reconstructed effective force is therefore the actuator contribution actually represented in that discrete velocity solve. Pairing that impulse with midpoint velocity gives the exact kinetic-work identity for the fixed-configuration velocity update.",
    "force_limit_adequacy": "The MuJoCo 3.11 derivative source branches on reported actuator_force: force at or outside either declared range contributes no derivative. The observer uses that exact branch and independently cross-checks the reported force against the direct velocity-servo equation and force range.",
    "constraint_adequacy": "qfrc_constraint enters the implicitfast right-hand side but not qDeriv. It is therefore treated as a constant generalized impulse over the velocity update and paired with midpoint generalized velocity.",
    "refusal_adequacy": "Nonzero damping, fluid, or adhesion force is refused because those terms can have their own velocity derivatives. Treating them as explicit midpoint forces without a qualified derivative mapping would recreate the same staging error under a different name.",
    "remaining_uncertainty": "This zero-world algebra does not establish total mechanical-energy closure after MuJoCo's subsequent position update, contact adequacy, the magnitude of the remaining trajectory residual, recovery handoff, or standing. Those require a distinct wired observer and finite physical development result after qualification.",
    "new_behavior_threshold_count": 0,
    "new_empirical_threshold_count": 0,
    "new_margin_count": 0,
    "population_claim_count": 0
  },
  "controlled_change": {
    "changed_surface": "Add one reusable pure implicit-step work observer for the exact direct velocity-servo subset and a zero-world qualification boundary. Do not wire it into the physical recovery route under this identity.",
