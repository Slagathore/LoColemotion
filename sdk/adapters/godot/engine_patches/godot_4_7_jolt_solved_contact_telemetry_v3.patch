+void HingeConstraint::AccumulateMotorWork(float inAppliedImpulse, float inRelativeAngularVelocityBefore, float inRelativeAngularVelocityAfter)
+{
+	// For J = [0, -a^T, 0, a^T], this is the exact kinetic-energy
+	// change caused by this angular impulse: lambda * (Jv_before +
+	// Jv_after) / 2. Splitting by sign preserves both supplied and
+	// absorbed actuator work without cancellation.
+	float work = inAppliedImpulse * 0.5f * (inRelativeAngularVelocityBefore + inRelativeAngularVelocityAfter);
+	if (work >= 0.0f)
+		mPositiveMotorWork += work;
+	else
+		mAbsorbedMotorWork -= work;
+}
