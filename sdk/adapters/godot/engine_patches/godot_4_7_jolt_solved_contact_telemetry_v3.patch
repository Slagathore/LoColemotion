+		return Variant();
+	}
+
+	JoltSpace3D *space = physics_server->space_owner.get_or_null(p_space);
+	if (space == nullptr || space->is_stepping()) {
+		return Variant();
+	}
+
+	JoltSolvedContactTelemetry3D telemetry;
