+
+	Dictionary result;
+	result["schema"] = "sporespore.godot_jolt_solved_contact_telemetry.v1";
+	result["profile_id"] = "godot_4_7_jolt_sporespore_solved_contact_telemetry_v1";
+	result["capture_space_step_sequence"] = static_cast<int64_t>(telemetry.capture_space_step_sequence);
+	result["read_space_step_sequence"] = static_cast<int64_t>(space->get_step_sequence());
+	result["captured_during_active_step"] = telemetry.captured_during_active_step;
+	result["snapshot_is_current_space_step"] = telemetry.capture_space_step_sequence == space->get_step_sequence();
+	result["reported_manifold_count"] = telemetry.reported_manifold_count;
+	result["reported_contact_point_count"] = telemetry.reported_contact_point_count;
+	result["exact_manifold_count"] = telemetry.exact_manifold_count;
+	result["exact_contact_point_count"] = telemetry.exact_contact_point_count;
+	result["missing_manifold_count"] = telemetry.missing_manifold_count;
+	result["ccd_only_manifold_count"] = telemetry.ccd_only_manifold_count;
+	result["point_count_mismatch_count"] = telemetry.point_count_mismatch_count;
+	result["nonfinite_impulse_count"] = telemetry.nonfinite_impulse_count;
+	result["complete"] = telemetry.complete;
+	return result;
+}
