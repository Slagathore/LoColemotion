+ContactConstraintManager::ESolvedContactImpulseStatus ContactConstraintManager::GetSolvedContactPointImpulses(const SubShapeIDPair &inShapePair, SolvedContactPointImpulses &outImpulses) const
+{
+	outImpulses.clear();
+
+	const ManifoldCache &read_cache = mCache[mCacheWriteIdx ^ 1];
+	const MKeyValue *kv = read_cache.Find(inShapePair, inShapePair.GetHash());
+	if (kv == nullptr)
+		return ESolvedContactImpulseStatus::MissingManifold;
+
+	const CachedManifold &manifold = kv->GetValue();
+	if ((manifold.mFlags.load() & (uint16)CachedManifold::EFlags::CCDContact) != 0)
+		return ESolvedContactImpulseStatus::CCDOnlyManifold;
+
+	outImpulses.resize(manifold.mNumContactPoints);
+	for (uint32 i = 0; i < manifold.mNumContactPoints; ++i)
+	{
+		const CachedContactPoint &point = manifold.mContactPoints[i];
+		SolvedContactPointImpulse &impulse = outImpulses[i];
+		impulse.mNormalImpulse = point.mNonPenetrationLambda;
+		impulse.mFrictionImpulse1 = point.mFrictionLambda[0];
+		impulse.mFrictionImpulse2 = point.mFrictionLambda[1];
+	}
+
+	return ESolvedContactImpulseStatus::Success;
+}
