+void JoltContactListener3D::capture_solved_contact_impulses(uint64_t p_space_step_sequence) {
+	solved_contact_telemetry = JoltSolvedContactTelemetry3D();
+	solved_contact_telemetry.capture_space_step_sequence = p_space_step_sequence;
+	solved_contact_telemetry.captured_during_active_step = space->is_stepping();
+	solved_contact_telemetry_valid = true;
+
+	JPH::PhysicsSystem &physics_system = space->get_physics_system();
+	for (KeyValue<JPH::SubShapeIDPair, Manifold> &E : manifolds_by_shape_pair) {
+		Manifold &manifold = E.value;
+		if (manifold.contacts1.is_empty() && manifold.contacts2.is_empty()) {
+			continue;
+		}
+
+		solved_contact_telemetry.reported_manifold_count++;
+		solved_contact_telemetry.reported_contact_point_count += manifold.contacts1.size();
+
+		JPH::ContactConstraintManager::SolvedContactPointImpulses impulses;
+		const JPH::ContactConstraintManager::ESolvedContactImpulseStatus status = physics_system.GetSolvedContactPointImpulses(E.key, impulses);
+		if (status == JPH::ContactConstraintManager::ESolvedContactImpulseStatus::MissingManifold) {
+			solved_contact_telemetry.missing_manifold_count++;
+			continue;
+		}
+		if (status == JPH::ContactConstraintManager::ESolvedContactImpulseStatus::CCDOnlyManifold) {
+			solved_contact_telemetry.ccd_only_manifold_count++;
+			continue;
+		}
+		if (manifold.contacts1.size() != manifold.contacts2.size() || manifold.contacts1.size() != impulses.size()) {
+			solved_contact_telemetry.point_count_mismatch_count++;
+			continue;
+		}
+
+		bool finite = true;
+		for (const JPH::ContactConstraintManager::SolvedContactPointImpulse &impulse : impulses) {
+			if (!Math::is_finite(impulse.mNormalImpulse) || !Math::is_finite(impulse.mFrictionImpulse1) || !Math::is_finite(impulse.mFrictionImpulse2)) {
+				finite = false;
+				solved_contact_telemetry.nonfinite_impulse_count++;
+			}
+		}
+		if (!finite) {
+			continue;
+		}
+
+		for (uint32_t i = 0; i < impulses.size(); ++i) {
+			const JPH::Vec3 normal = to_jolt(manifold.contacts2[i].normal);
+			const JPH::Vec3 tangent1 = normal.GetNormalizedPerpendicular();
+			const JPH::Vec3 tangent2 = normal.Cross(tangent1);
+			const JPH::ContactConstraintManager::SolvedContactPointImpulse &impulse = impulses[i];
+			const Vector3 combined_impulse = to_godot(
+					normal * impulse.mNormalImpulse +
+					tangent1 * impulse.mFrictionImpulse1 +
+					tangent2 * impulse.mFrictionImpulse2);
+			manifold.contacts1[i].impulse = -combined_impulse;
+			manifold.contacts2[i].impulse = combined_impulse;
+		}
+
+		solved_contact_telemetry.exact_manifold_count++;
+		solved_contact_telemetry.exact_contact_point_count += impulses.size();
+	}
+
+	solved_contact_telemetry.complete =
+			solved_contact_telemetry.captured_during_active_step &&
+			solved_contact_telemetry.reported_manifold_count == solved_contact_telemetry.exact_manifold_count &&
+			solved_contact_telemetry.reported_contact_point_count == solved_contact_telemetry.exact_contact_point_count &&
+			solved_contact_telemetry.missing_manifold_count == 0 &&
+			solved_contact_telemetry.ccd_only_manifold_count == 0 &&
+			solved_contact_telemetry.point_count_mismatch_count == 0 &&
+			solved_contact_telemetry.nonfinite_impulse_count == 0;
+}
+
+bool JoltContactListener3D::try_get_solved_contact_telemetry(JoltSolvedContactTelemetry3D &r_telemetry) const {
+	if (!solved_contact_telemetry_valid) {
+		return false;
+	}
+	r_telemetry = solved_contact_telemetry;
+	return true;
+}
