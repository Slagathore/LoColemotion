+Variant JoltPhysicsServer3D::hinge_joint_get_motor_telemetry(RID p_joint) {
+	JoltPhysicsServer3D *physics_server = get_singleton();
+	if (physics_server == nullptr || (physics_server->on_separate_thread && !physics_server->doing_sync)) {
+		return Variant();
+	}
+
+	JoltJoint3D *joint = physics_server->joint_owner.get_or_null(p_joint);
+	if (joint == nullptr || joint->get_type() != JOINT_TYPE_HINGE) {
+		return Variant();
+	}
+
+	JoltSpace3D *space = joint->get_space();
+	if (space == nullptr || space->is_stepping()) {
+		return Variant();
+	}
+
+	JoltHingeJoint3D::MotorTelemetry motor_telemetry;
+	JoltHingeJoint3D *hinge_joint = static_cast<JoltHingeJoint3D *>(joint);
+	if (!hinge_joint->try_get_motor_telemetry(motor_telemetry)) {
+		return Variant();
+	}
+
+	String motor_state;
+	switch (static_cast<JPH::EMotorState>(motor_telemetry.motor_state)) {
+		case JPH::EMotorState::Off:
+			motor_state = "off";
+			break;
+		case JPH::EMotorState::Velocity:
+			motor_state = "velocity";
+			break;
+		case JPH::EMotorState::Position:
+			motor_state = "position";
+			break;
+	}
+
+	Dictionary result;
+	result["schema"] = "sporespore.godot_jolt_hinge_motor_telemetry.v2";
+	result["telemetry_sequence"] = static_cast<int64_t>(motor_telemetry.sequence);
+	result["capture_space_step_sequence"] = static_cast<int64_t>(motor_telemetry.capture_space_step_sequence);
+	result["read_space_step_sequence"] = static_cast<int64_t>(motor_telemetry.read_space_step_sequence);
+	result["captured_during_active_step"] = motor_telemetry.captured_during_active_step;
+	result["snapshot_is_current_space_step"] = motor_telemetry.capture_space_step_sequence == motor_telemetry.read_space_step_sequence;
+	result["solver_step_s"] = motor_telemetry.solver_step_s;
+	result["motor_state"] = motor_state;
+	result["target_angular_velocity_rad_s"] = motor_telemetry.target_angular_velocity_rad_s;
+	result["min_torque_limit_nm"] = motor_telemetry.min_torque_limit_nm;
+	result["max_torque_limit_nm"] = motor_telemetry.max_torque_limit_nm;
+	result["signed_motor_impulse_nms"] = motor_telemetry.signed_motor_impulse_nms;
+	result["positive_motor_work_j"] = motor_telemetry.positive_motor_work_j;
+	result["absorbed_motor_work_j"] = motor_telemetry.absorbed_motor_work_j;
+	result["net_motor_work_j"] = motor_telemetry.positive_motor_work_j - motor_telemetry.absorbed_motor_work_j;
+	return result;
+}
