+bool JoltHingeJoint3D::try_get_motor_telemetry(MotorTelemetry &r_telemetry) const {
+	if (unlikely(_is_fixed()) || jolt_ref == nullptr) {
+		return false;
+	}
+
+	const JPH::HingeConstraint *constraint = static_cast<const JPH::HingeConstraint *>(jolt_ref.GetPtr());
+	const uint64_t sequence = constraint->GetMotorTelemetrySequence();
+	const float solver_step_s = constraint->GetMotorTelemetryStep();
+	if (sequence == 0 || solver_step_s <= 0.0f) {
+		return false;
+	}
+
+	r_telemetry.sequence = sequence;
+	r_telemetry.solver_step_s = solver_step_s;
+	r_telemetry.motor_state = static_cast<int32_t>(constraint->GetMotorTelemetryState());
+	r_telemetry.target_angular_velocity_rad_s = constraint->GetMotorTelemetryTargetAngularVelocity();
+	r_telemetry.min_torque_limit_nm = constraint->GetMotorTelemetryMinTorqueLimit();
+	r_telemetry.max_torque_limit_nm = constraint->GetMotorTelemetryMaxTorqueLimit();
+	r_telemetry.signed_motor_impulse_nms = constraint->GetTotalLambdaMotor();
+	r_telemetry.positive_motor_work_j = constraint->GetPositiveMotorWork();
+	r_telemetry.absorbed_motor_work_j = constraint->GetAbsorbedMotorWork();
+	return true;
+}
