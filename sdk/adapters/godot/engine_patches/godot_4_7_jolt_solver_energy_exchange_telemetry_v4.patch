+void PhysicsSystem::BeginSporeSporeSolverEnergyExchange(uint32 inCollisionStepCount, uint32 inActiveSoftBodyCount)
+{
+	lock_guard lock(mSporeSporeSolverEnergyExchangeMutex);
+	uint64 sequence = mSporeSporeSolverEnergyExchangeTelemetry.mSequence + 1;
+	if (sequence == 0)
+		sequence = 1;
+	mSporeSporeSolverEnergyExchangeTelemetry = SporeSporeSolverEnergyExchangeTelemetry();
+	mSporeSporeSolverEnergyExchangeTelemetry.mSequence = sequence;
+	mSporeSporeSolverEnergyExchangeTelemetry.mCollisionStepCount = inCollisionStepCount;
+	mSporeSporeSolverEnergyExchangeTelemetry.mActiveSoftBodyCount = inActiveSoftBodyCount;
+}
+
+void PhysicsSystem::RecordSporeSporeVelocityExchange(double inJointExchangeJ, double inContactExchangeJ, uint32 inJointPhaseCount, uint32 inContactPhaseCount, uint32 inDynamicBodyObservationCount, uint32 inInvalidBodyMeasurementCount, bool inIslandComplete)
+{
+	lock_guard lock(mSporeSporeSolverEnergyExchangeMutex);
+	SporeSporeSolverEnergyExchangeTelemetry &telemetry = mSporeSporeSolverEnergyExchangeTelemetry;
+	if (isfinite(inJointExchangeJ) && isfinite(inContactExchangeJ))
+	{
+		telemetry.mJointVelocityConstraintExchangeJ += inJointExchangeJ;
+		telemetry.mContactVelocityConstraintExchangeJ += inContactExchangeJ;
+	}
+	else
+	{
+		++inInvalidBodyMeasurementCount;
+		inIslandComplete = false;
+	}
+	telemetry.mJointVelocityPhaseCount += inJointPhaseCount;
+	telemetry.mContactVelocityPhaseCount += inContactPhaseCount;
+	telemetry.mDynamicBodyObservationCount += inDynamicBodyObservationCount;
+	telemetry.mInvalidBodyMeasurementCount += inInvalidBodyMeasurementCount;
+	++telemetry.mConstrainedIslandCount;
+	if (inIslandComplete)
+		++telemetry.mVelocityMeasuredIslandCount;
+}
+
+void PhysicsSystem::RecordSporeSporePositionExchange(double inKineticExchangeJ, RVec3Arg inMassWeightedDisplacementKgM, uint32 inPhaseCount, uint32 inDynamicBodyObservationCount, uint32 inInvalidBodyMeasurementCount, bool inIslandComplete)
+{
+	lock_guard lock(mSporeSporeSolverEnergyExchangeMutex);
+	SporeSporeSolverEnergyExchangeTelemetry &telemetry = mSporeSporeSolverEnergyExchangeTelemetry;
+	const bool finite_displacement = isfinite(double(inMassWeightedDisplacementKgM.GetX()))
+		&& isfinite(double(inMassWeightedDisplacementKgM.GetY()))
+		&& isfinite(double(inMassWeightedDisplacementKgM.GetZ()));
+	if (isfinite(inKineticExchangeJ) && finite_displacement)
+	{
+		telemetry.mPositionConstraintKineticExchangeJ += inKineticExchangeJ;
+		telemetry.mPositionConstraintMassWeightedDisplacementKgM += inMassWeightedDisplacementKgM;
+	}
+	else
+	{
+		++inInvalidBodyMeasurementCount;
+		inIslandComplete = false;
+	}
+	telemetry.mPositionConstraintPhaseCount += inPhaseCount;
+	telemetry.mDynamicBodyObservationCount += inDynamicBodyObservationCount;
+	telemetry.mInvalidBodyMeasurementCount += inInvalidBodyMeasurementCount;
+	if (inIslandComplete)
+		++telemetry.mPositionMeasuredIslandCount;
+}
