+PhysicsSystem::SporeSporeEnergySnapshot PhysicsSystem::MeasureSporeSporeEnergy(const BodyID *inBodiesBegin, const BodyID *inBodiesEnd) const
+{
+	auto finite_vec3 = [](Vec3Arg inValue) {
+		return isfinite(inValue.GetX()) && isfinite(inValue.GetY()) && isfinite(inValue.GetZ());
+	};
+	auto finite_rvec3 = [](RVec3Arg inValue) {
+		return isfinite(double(inValue.GetX())) && isfinite(double(inValue.GetY())) && isfinite(double(inValue.GetZ()));
+	};
+	SporeSporeEnergySnapshot result;
+	for (const BodyID *body_id = inBodiesBegin; body_id < inBodiesEnd; ++body_id)
+	{
+		const Body &body = mBodyManager.GetBody(*body_id);
+		if (!body.IsDynamic())
+		{
+			++result.mInvalidBodyCount;
+			continue;
+		}
+
+		const MotionProperties *motion = body.GetMotionPropertiesUnchecked();
+		const float inverse_mass = motion->GetInverseMassUnchecked();
+		const Vec3 linear_velocity = motion->GetLinearVelocity();
+		const Vec3 angular_velocity = motion->GetAngularVelocity();
+		const RVec3 body_origin = body.GetPosition();
+		Mat44 inertia;
+		const Mat44 inverse_inertia = motion->GetInverseInertiaForRotation(Mat44::sRotation(body.GetRotation()));
+		if (inverse_mass <= 0.0f
+			|| !finite_vec3(linear_velocity)
+			|| !finite_vec3(angular_velocity)
+			|| !finite_rvec3(body_origin)
+			|| !inertia.SetInversed3x3(inverse_inertia))
+		{
+			++result.mInvalidBodyCount;
+			continue;
+		}
+
+		const double mass = 1.0 / double(inverse_mass);
+		const double translational = 0.5 * mass * double(linear_velocity.LengthSq());
+		const double rotational = 0.5 * double(angular_velocity.Dot(inertia.Multiply3x3(angular_velocity)));
+		const double kinetic = translational + rotational;
+		if (!isfinite(mass) || !isfinite(kinetic) || kinetic < 0.0)
+		{
+			++result.mInvalidBodyCount;
+			continue;
+		}
+
+		result.mKineticEnergyJ += kinetic;
+		result.mMassWeightedBodyOriginKgM += body_origin * float(mass);
+		++result.mDynamicBodyCount;
+	}
+
+	if (!isfinite(result.mKineticEnergyJ) || !finite_rvec3(result.mMassWeightedBodyOriginKgM))
+		++result.mInvalidBodyCount;
+	return result;
+}
