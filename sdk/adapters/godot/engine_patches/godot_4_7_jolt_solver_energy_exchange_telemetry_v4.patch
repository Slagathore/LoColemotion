+bool JoltHingeJoint3D::try_get_motor_telemetry(MotorTelemetry &r_telemetry) const {
+	if (unlikely(_is_fixed()) || !motor_telemetry_snapshot_valid) {
+		return false;
+	}
+
+	JoltSpace3D *space = get_space();
+	if (space == nullptr) {
+		return false;
+	}
+
+	r_telemetry = motor_telemetry_snapshot;
+	r_telemetry.read_space_step_sequence = space->get_step_sequence();
+	return true;
+}
+
+void JoltHingeJoint3D::capture_post_step_telemetry(uint64_t p_space_step_sequence, float p_space_step_s) {
+	JoltSpace3D *space = get_space();
+	const bool captured_during_active_step = space != nullptr && space->is_stepping();
+	if (unlikely(!captured_during_active_step || p_space_step_sequence == 0 || p_space_step_s <= 0.0f || _is_fixed() || jolt_ref == nullptr)) {
+		return;
+	}
+
+	const JPH::HingeConstraint *constraint = static_cast<const JPH::HingeConstraint *>(jolt_ref.GetPtr());
+	const uint64_t sequence = constraint->GetMotorTelemetrySequence();
+	const float solver_step_s = constraint->GetMotorTelemetryStep();
+	if (sequence == 0 || solver_step_s <= 0.0f || solver_step_s != p_space_step_s || (motor_telemetry_snapshot_valid && sequence == motor_telemetry_snapshot.sequence)) {
+		return;
+	}
+
+	motor_telemetry_snapshot.sequence = sequence;
+	motor_telemetry_snapshot.capture_space_step_sequence = p_space_step_sequence;
+	motor_telemetry_snapshot.read_space_step_sequence = p_space_step_sequence;
+	motor_telemetry_snapshot.captured_during_active_step = captured_during_active_step;
+	motor_telemetry_snapshot.solver_step_s = solver_step_s;
+	motor_telemetry_snapshot.motor_state = static_cast<int32_t>(constraint->GetMotorTelemetryState());
+	motor_telemetry_snapshot.target_angular_velocity_rad_s = constraint->GetMotorTelemetryTargetAngularVelocity();
+	motor_telemetry_snapshot.min_torque_limit_nm = constraint->GetMotorTelemetryMinTorqueLimit();
+	motor_telemetry_snapshot.max_torque_limit_nm = constraint->GetMotorTelemetryMaxTorqueLimit();
+	motor_telemetry_snapshot.signed_motor_impulse_nms = constraint->GetTotalLambdaMotor();
+	motor_telemetry_snapshot.positive_motor_work_j = constraint->GetPositiveMotorWork();
+	motor_telemetry_snapshot.absorbed_motor_work_j = constraint->GetAbsorbedMotorWork();
+	motor_telemetry_snapshot_valid = true;
+}
