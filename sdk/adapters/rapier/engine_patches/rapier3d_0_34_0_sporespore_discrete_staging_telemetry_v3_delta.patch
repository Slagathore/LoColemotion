+    pub fn sporespore_raw_gravity_potential(&self, gravity: Vector) -> Real {
+        let mut energy = 0.0;
+
+        for pose in &self.poses {
+            let inverse_mass = (0..3).map(|axis| pose.im[axis]).find(|value| *value != 0.0);
+            if let Some(inverse_mass) = inverse_mass {
+                energy -= gravity.dot(pose.translation) / inverse_mass;
+            }
+        }
+
+        energy
+    }
