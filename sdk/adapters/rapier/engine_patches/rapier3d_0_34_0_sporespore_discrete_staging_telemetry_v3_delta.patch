+/// Exact force, position, and endpoint-projection staging telemetry for one outer step.
+#[cfg(feature = "sporespore-discrete-staging-telemetry")]
+#[derive(Copy, Clone, Debug, Default, PartialEq)]
+pub struct SporeSporeDiscreteStagingTelemetry {
+    /// Monotonic publication sequence for completed outer pipeline steps.
+    pub sequence: u64,
+    /// Ordered scalar-solver measurements retained without aggregation.
+    pub small_steps: [SporeSporeDiscreteStagingSmallStepTelemetry;
+        SPORESPORE_DISCRETE_STAGING_SMALL_STEP_CAPACITY],
+    /// Total small-step measurements observed, including any beyond capacity.
+    pub small_step_count: u32,
+    /// Measurements that could not be retained in the fixed qualified population.
+    pub overflow_small_step_count: u32,
+    /// Number of island solves contributing staging measurements.
+    pub island_solve_count: u32,
+    /// Number of CCD time slices contributing staging measurements.
+    pub ccd_substep_count: u32,
+    /// Aggregate half-step potential projection before the outer step.
+    pub endpoint_half_step_projection_before_j: Real,
+    /// Aggregate half-step potential projection after the outer step.
+    pub endpoint_half_step_projection_after_j: Real,
+    /// Enabled dynamic-body population sampled at the initial endpoint.
+    pub endpoint_body_count_before: u32,
+    /// Enabled dynamic-body population sampled at the final endpoint.
+    pub endpoint_body_count_after: u32,
+    /// True only when both endpoint values were sampled at their native boundaries.
+    pub endpoint_source_measurement: bool,
+}
+
+#[cfg(feature = "sporespore-discrete-staging-telemetry")]
+impl SporeSporeDiscreteStagingTelemetry {
+    fn begin_outer_step(&mut self, endpoint_projection_j: Real, body_count: u32) {
+        let sequence = self.sequence.saturating_add(1);
+        *self = Self::default();
+        self.sequence = sequence;
+        self.endpoint_half_step_projection_before_j = endpoint_projection_j;
+        self.endpoint_body_count_before = body_count;
+    }
+
+    fn accumulate(&mut self, sample: SporeSporeSolverDiscreteStagingTelemetry) {
+        let retained_count = usize::try_from(sample.small_step_count)
+            .unwrap_or(usize::MAX)
+            .min(SPORESPORE_DISCRETE_STAGING_SMALL_STEP_CAPACITY);
+        for source in sample.small_steps.iter().take(retained_count) {
+            if let Some(destination) = self.small_steps.get_mut(self.small_step_count as usize) {
+                *destination = *source;
+            } else {
+                self.overflow_small_step_count = self.overflow_small_step_count.saturating_add(1);
+            }
+            self.small_step_count = self.small_step_count.saturating_add(1);
+        }
+        let unretained_count = sample
+            .small_step_count
+            .saturating_sub(u32::try_from(retained_count).unwrap_or(u32::MAX));
+        self.small_step_count = self.small_step_count.saturating_add(unretained_count);
+        self.overflow_small_step_count = self
+            .overflow_small_step_count
+            .saturating_add(sample.overflow_small_step_count);
+        self.island_solve_count = self.island_solve_count.saturating_add(1);
+    }
+
+    fn complete_outer_step(&mut self, endpoint_projection_j: Real, body_count: u32) {
+        self.endpoint_half_step_projection_after_j = endpoint_projection_j;
+        self.endpoint_body_count_after = body_count;
+        self.endpoint_source_measurement = true;
+    }
+}
+
+#[cfg(feature = "sporespore-discrete-staging-telemetry")]
+fn sporespore_endpoint_half_step_projection(
+    bodies: &RigidBodySet,
+    gravity: Vector,
+    outer_step_dt: Real,
+) -> (Real, u32) {
+    let mut projection = 0.0;
+    let mut body_count = 0_u32;
+    for (_, body) in bodies.iter() {
+        if body.is_enabled() && body.is_dynamic() {
+            projection += body.mass()
+                * body.gravity_scale()
+                * gravity.dot(body.linvel())
+                * outer_step_dt
+                * 0.5;
+            body_count = body_count.saturating_add(1);
+        }
+    }
+    (projection, body_count)
+}
