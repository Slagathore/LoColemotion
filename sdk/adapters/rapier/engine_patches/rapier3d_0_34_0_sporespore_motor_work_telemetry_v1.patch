+/// Exact per-outer-step telemetry accumulated by the SporeSpore solver patch.
+#[cfg(feature = "sporespore-motor-work-telemetry")]
+#[cfg_attr(feature = "serde-serialize", derive(Serialize, Deserialize))]
+#[derive(Copy, Clone, Debug, PartialEq)]
+pub struct JointMotorWorkTelemetry {
+    /// Monotonic publication sequence for active outer solver steps.
+    pub sequence: u64,
+    /// Sum of signed generalized motor impulse in the body2-minus-body1 coordinate.
+    pub generalized_impulse: Real,
+    /// Sum of absolute generalized motor impulse.
+    pub absolute_generalized_impulse: Real,
+    /// Positive work supplied by the motor.
+    pub supplied_work: Real,
+    /// Positive magnitude of work absorbed by the motor.
+    pub absorbed_work: Real,
+    /// Signed net motor work accumulated at every solver application.
+    pub net_work: Real,
+    /// Number of iterative motor-constraint applications observed.
+    pub application_count: u32,
+    /// Number of solver small steps in which this motor constraint was built.
+    pub small_step_count: u32,
+}
+
+#[cfg(feature = "sporespore-motor-work-telemetry")]
+impl Default for JointMotorWorkTelemetry {
+    fn default() -> Self {
+        Self {
+            sequence: 0,
+            generalized_impulse: 0.0,
+            absolute_generalized_impulse: 0.0,
+            supplied_work: 0.0,
+            absorbed_work: 0.0,
+            net_work: 0.0,
+            application_count: 0,
+            small_step_count: 0,
+        }
+    }
+}
