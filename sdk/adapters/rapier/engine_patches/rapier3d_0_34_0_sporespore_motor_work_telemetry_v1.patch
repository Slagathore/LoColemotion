+    #[cfg(feature = "sporespore-motor-work-telemetry")]
+    pub(crate) fn solve_with_sporespore_motor_work(
+        &mut self,
+        solver_vels: &mut SolverBodies,
+    ) -> Option<SporeSporeMotorWorkSample> {
+        let motor_axis = match self.writeback_id {
+            WritebackId::Motor(axis) => Some(axis),
+            _ => None,
+        };
+        let mut solver_vel1 = solver_vels.get_vel(self.solver_vel1[0]);
+        let mut solver_vel2 = solver_vels.get_vel(self.solver_vel2[0]);
+        let relative_velocity_before = self
+            .lin_jac
+            .gdot(solver_vel2.linear - solver_vel1.linear)
+            + self.ang_jac2.gdot(solver_vel2.angular)
+            - self.ang_jac1.gdot(solver_vel1.angular);
+        let constraint_impulse_before = self.impulse;
+
+        self.solve_generic(&mut solver_vel1, &mut solver_vel2);
+
+        let relative_velocity_after = self
+            .lin_jac
+            .gdot(solver_vel2.linear - solver_vel1.linear)
+            + self.ang_jac2.gdot(solver_vel2.angular)
+            - self.ang_jac1.gdot(solver_vel1.angular);
+        let constraint_delta_impulse = self.impulse - constraint_impulse_before;
+        let generalized_impulse = -constraint_delta_impulse;
+        let work = generalized_impulse
+            * (relative_velocity_before + relative_velocity_after)
+            * 0.5;
+
+        solver_vels.set_vel(self.solver_vel1[0], solver_vel1);
+        solver_vels.set_vel(self.solver_vel2[0], solver_vel2);
+
+        motor_axis.map(|motor_axis| SporeSporeMotorWorkSample {
+            joint_id: self.joint_id[0],
+            motor_axis,
+            generalized_impulse,
+            work,
+        })
+    }
