+/// Exact per-outer-step scalar solver-phase energy telemetry for SporeSpore.
+#[cfg(feature = "sporespore-energy-exchange-telemetry")]
+#[derive(Copy, Clone, Debug, Default, PartialEq)]
+pub struct SporeSporeEnergyExchangeTelemetry {
+    /// Monotonic publication sequence for completed outer pipeline steps.
+    pub sequence: u64,
+    /// Independently accumulated exchange across every measured constraint phase.
+    pub total_constraint_exchange_j: Real,
+    /// Exchange accumulated across joint phases, including motor constraints.
+    pub joint_constraint_exchange_j: Real,
+    /// Exchange accumulated across contact, friction, and contact warmstart phases.
+    pub contact_constraint_exchange_j: Real,
