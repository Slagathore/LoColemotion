+    #[cfg(feature = "sporespore-motor-work-telemetry")]
+    fn sporespore_motor_work_entry_mut(
+        entries: &mut Vec<SporeSporeMotorWorkEntry>,
+        joint_id: JointIndex,
+        motor_axis: usize,
+    ) -> &mut SporeSporeMotorWorkEntry {
+        if let Some(index) = entries
+            .iter()
+            .position(|entry| entry.joint_id == joint_id && entry.motor_axis == motor_axis)
+        {
+            return &mut entries[index];
+        }
+        entries.push(SporeSporeMotorWorkEntry {
+            joint_id,
+            motor_axis,
+            generalized_impulse: 0.0,
+            absolute_generalized_impulse: 0.0,
+            supplied_work: 0.0,
+            absorbed_work: 0.0,
+            net_work: 0.0,
+            application_count: 0,
+            small_step_count: 0,
+        });
+        entries
+            .last_mut()
+            .expect("the SporeSpore motor-work entry was just inserted")
+    }
+
+    #[cfg(feature = "sporespore-motor-work-telemetry")]
+    fn record_sporespore_motor_work(
+        entries: &mut Vec<SporeSporeMotorWorkEntry>,
+        sample: SporeSporeMotorWorkSample,
+    ) {
+        let entry = Self::sporespore_motor_work_entry_mut(
+            entries,
+            sample.joint_id,
+            sample.motor_axis,
+        );
+        entry.generalized_impulse += sample.generalized_impulse;
+        entry.absolute_generalized_impulse += sample.generalized_impulse.abs();
+        entry.net_work += sample.work;
+        if sample.work >= 0.0 {
+            entry.supplied_work += sample.work;
+        } else {
+            entry.absorbed_work += -sample.work;
+        }
+        entry.application_count = entry.application_count.saturating_add(1);
+    }
