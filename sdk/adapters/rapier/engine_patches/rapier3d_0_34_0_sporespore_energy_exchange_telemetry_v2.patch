+    pub constraint_phase_count: u32,
+    /// Number of measured joint solve phases.
+    pub joint_phase_count: u32,
+    /// Number of measured contact solve phases, excluding warmstart.
+    pub contact_phase_count: u32,
+    /// Number of measured contact warmstart phases.
+    pub contact_warmstart_phase_count: u32,
+    /// Number of solver small steps observed across supported islands.
+    pub small_step_count: u32,
+    /// Number of supported island solves accumulated into this publication.
+    pub island_solve_count: u32,
+    /// Number of CCD time slices accumulated into this publication.
+    pub ccd_substep_count: u32,
+    /// Number of active scalar rigid-body observations.
+    pub active_body_observation_count: u32,
+    /// Number of active scalar bodies that were not dynamic.
+    pub non_dynamic_body_count: u32,
+    /// Number of active scalar bodies with any locked degree of freedom.
+    pub locked_axis_body_count: u32,
+    /// Number of active scalar bodies with nonzero linear damping.
+    pub nonzero_linear_damping_body_count: u32,
+    /// Number of active scalar bodies with nonzero angular damping.
+    pub nonzero_angular_damping_body_count: u32,
+    /// Number of active scalar bodies whose gravity scale was not one.
+    pub nonunit_gravity_scale_body_count: u32,
+    /// Number of active scalar bodies with nonzero persistent user force.
+    pub nonzero_user_force_body_count: u32,
+    /// Number of active scalar bodies with nonzero persistent user torque.
+    pub nonzero_user_torque_body_count: u32,
+    /// Number of active scalar bodies with gyroscopic-force integration enabled.
