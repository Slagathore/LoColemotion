+            .saturating_add(sample.nonzero_linear_damping_body_count);
+        self.nonzero_angular_damping_body_count = self
+            .nonzero_angular_damping_body_count
+            .saturating_add(sample.nonzero_angular_damping_body_count);
+        self.nonunit_gravity_scale_body_count = self
+            .nonunit_gravity_scale_body_count
+            .saturating_add(sample.nonunit_gravity_scale_body_count);
+        self.nonzero_user_force_body_count = self
