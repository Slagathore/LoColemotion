+
+#[cfg(feature = "sporespore-energy-exchange-telemetry")]
+impl SporeSporeEnergyExchangeTelemetry {
+    fn begin_outer_step(&mut self) {
+        let sequence = self.sequence.saturating_add(1);
+        *self = Self::default();
+        self.sequence = sequence;
+    }
+
+    fn accumulate(&mut self, sample: SporeSporeSolverEnergyExchange) {
+        self.total_constraint_exchange_j += sample.total_constraint_exchange;
+        self.joint_constraint_exchange_j += sample.joint_constraint_exchange;
+        self.contact_constraint_exchange_j += sample.contact_constraint_exchange;
+        self.contact_warmstart_exchange_j += sample.contact_warmstart_exchange;
+        self.constraint_phase_count = self
+            .constraint_phase_count
+            .saturating_add(sample.constraint_phase_count);
+        self.joint_phase_count = self.joint_phase_count.saturating_add(sample.joint_phase_count);
+        self.contact_phase_count = self
+            .contact_phase_count
+            .saturating_add(sample.contact_phase_count);
+        self.contact_warmstart_phase_count = self
+            .contact_warmstart_phase_count
+            .saturating_add(sample.contact_warmstart_phase_count);
+        self.small_step_count = self.small_step_count.saturating_add(sample.small_step_count);
+        self.island_solve_count = self.island_solve_count.saturating_add(1);
+        self.active_body_observation_count = self
+            .active_body_observation_count
+            .saturating_add(sample.active_body_observation_count);
+        self.non_dynamic_body_count = self
+            .non_dynamic_body_count
+            .saturating_add(sample.non_dynamic_body_count);
+        self.locked_axis_body_count = self
+            .locked_axis_body_count
