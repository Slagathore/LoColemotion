+    #[cfg(feature = "sporespore-energy-exchange-telemetry")]
+    pub fn sporespore_kinetic_energy(&self) -> Real {
+        let mut energy = 0.0;
+
+        for (vel, pose) in self.vels.iter().zip(&self.poses) {
+            for axis in 0..3 {
+                let inv_mass = pose.im[axis];
+                if inv_mass != 0.0 {
+                    energy += vel.linear[axis] * vel.linear[axis] / inv_mass * 0.5;
+                }
+            }
+
+            if !pose.ii.is_zero() {
+                let inertia = pose.ii.inverse_unchecked();
+                energy += vel.angular.dot(inertia * vel.angular) * 0.5;
+            }
+        }
+
+        energy
+    }
